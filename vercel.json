{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/services/paid-ads", "destination": "/services/electrician-advertising", "permanent": true },
    { "source": "/services/local-seo", "destination": "/services/electrician-seo", "permanent": true },
    { "source": "/services/websites", "destination": "/services/electrician-websites", "permanent": true },
    { "source": "/services/hiring", "destination": "/services/hiring-electricians", "permanent": true },
    { "source": "/services/branding", "destination": "/services/electrician-branding", "permanent": true },
    { "source": "/services/tracking", "destination": "/services/electrician-lead-tracking", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
