# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env
.env
.env.production

# Internal / private working material. This repo is PUBLIC, so raw strategy notes
# and planning docs stay on disk only. Anything here is still referenced by the
# README structure so we know it exists, it just isn't published.
Found By Friday Brain Dumps/
content/

# docs/* rather than docs/ so the negation below works — git won't look inside a
# directory it has already excluded. BLOG-FRAMEWORK.md is an editorial standard the
# site depends on, so it ships; the client SEO playbook stays private.
docs/*
!docs/BLOG-FRAMEWORK.md

# macOS / editors
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
