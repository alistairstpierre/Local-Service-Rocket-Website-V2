# EmailJS for /contact free-audit form. Copy to .env and fill in.
# Attachments need EmailJS Personal plan + Form File Attachment params
# screenshot_1 … screenshot_4 on the template.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Railway analysis API for /free-report (no vendor keys on this site).
# Example: https://api-production-cdde3.up.railway.app
PUBLIC_ANALYSIS_API_URL=
