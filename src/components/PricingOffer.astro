---
/* Flight Plan pricing comparison table ("Every price, up front").
   Used on `/` (below testimonials) and `/get-started`. Data: src/data/pricing-tiers.ts.
   Desktop: label column + 3 stage columns aligned with CSS subgrid.
   Mobile: stage tabs + one card at a time, switched by hidden radio inputs (no JS). */
import { pricingTiers } from '../data/pricing-tiers';

interface Props {
  eyebrow?: string;
  h2?: string;
  sub?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  eyebrow = 'THE NUMBERS',
  h2 = 'Every price, up front.',
  sub = 'Fair pricing that scales as you grow.',
  ctaHref = '/get-started',
  ctaLabel = 'Schedule my onboarding call',
} = Astro.props;

const rowLabels = ["IF YOU'RE AT", 'YOU PAY', 'WE GET YOU TO', 'INCLUDED', 'ON TOP'];
const startIndex = Math.max(
  0,
  pricingTiers.findIndex((t) => t.featured),
);
---

<section class="pricing-offer" id="pricing">
  <div class="container">
    <div class="pt-head">
      <div class="eyebrow">{eyebrow}</div>
      <h2>{h2}</h2>
      <p>{sub}</p>
    </div>

    <div class="pt-table">
      <div class="pt-labels" aria-hidden="true">
        <div></div>
        {rowLabels.map((l) => <div class="pt-label">{l}</div>)}
      </div>

      {
        pricingTiers.map((tier) => (
          <div class:list={['pt-col', { 'pt-featured': tier.featured }]}>
            <div class="pt-name">
              {tier.featured && <div class="pt-badge">MOST SHOPS START HERE</div>}
              <div>
                {tier.step} · {tier.name}
              </div>
            </div>

            <div class="pt-cell pt-at">{tier.at}</div>

            <div class="pt-cell">
              <div class="pt-price">
                {tier.price.prefix && <span class="pt-prefix">{tier.price.prefix}</span>}
                <span class="pt-amount">{tier.price.amount}</span>
                {tier.price.unitBelow ? (
                  <div class="pt-unit">{tier.price.unit}</div>
                ) : (
                  <span class="pt-unit">{tier.price.unit}</span>
                )}
              </div>
            </div>

            <div class="pt-cell pt-gets">{tier.getsTo}</div>

            <div class="pt-cell pt-list">
              {tier.included.map((item) => (
                <div>{item}</div>
              ))}
            </div>

            <div class="pt-cell pt-list pt-last">
              {tier.onTop.map((line) => (
                <div>
                  {line.map((seg) =>
                    seg.href ? (
                      <a href={seg.href}>{seg.t}</a>
                    ) : seg.kind === 'strong' ? (
                      <b>{seg.t}</b>
                    ) : seg.kind === 'muted' ? (
                      <span class="pt-muted">{seg.t}</span>
                    ) : (
                      seg.t
                    ),
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="pm">
      {
        pricingTiers.map((tier, i) => (
          <input
            type="radio"
            name="pm-stage"
            id={`pm-stage-${i}`}
            class="pm-radio"
            checked={i === startIndex}
            aria-label={tier.name}
          />
        ))
      }

      <div class="pm-tabs">
        {
          pricingTiers.map((tier, i) => (
            <label for={`pm-stage-${i}`} class="pm-tab">
              {tier.name.replace('-', '\u2011')}
            </label>
          ))
        }
      </div>
      <div class="pm-hint">Tap a stage to compare</div>

      <div class="pm-cards">
        {
          pricingTiers.map((tier) => (
            <article class:list={['pm-card', { 'pm-featured': tier.featured }]}>
              {tier.featured && <div class="pm-badge">MOST SHOPS START HERE</div>}
              <div class="pm-top">
                <div class="pm-title">
                  <span class="pm-num">{tier.step}</span>
                  <span class="pm-name">{tier.name}</span>
                </div>
                <span class="pm-rev">{tier.at}</span>
              </div>

              <div class="pm-price">
                {tier.price.prefix && <span class="pm-prefix">{tier.price.prefix.trim()}</span>}
                <span class="pm-amount">{tier.price.amount}</span>
                <span class="pm-unit">{tier.price.unitMobile ?? tier.price.unit}</span>
              </div>
              <div class="pm-price-sub">{tier.priceSub}</div>

              <div class="pm-goal">
                <div class="pm-goal-label">WE GET YOU TO</div>
                <div class="pm-goal-text">{tier.getsTo}</div>
              </div>

              <div class="pm-label">INCLUDED</div>
              <ul class="pm-included">
                {tier.included.map((item) => (
                  <li>
                    <span class="pm-check" aria-hidden="true">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div class="pm-label pm-label-top">ON TOP</div>
              <div class="pm-extras">
                {tier.extras.map((x) => (
                  <div class="pm-extra">
                    <span class="pm-extra-label">
                      {x.href ? <a href={x.href}>{x.label}</a> : x.label}
                      <span class="pm-extra-note">{x.note}</span>
                    </span>
                    <b>{x.value}</b>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <div class="pm-dots" aria-hidden="true">
        {
          pricingTiers.map((_, i) => (
            <label for={`pm-stage-${i}`} class="pm-dot" />
          ))
        }
      </div>
    </div>

    <div class="pt-foot">
      <a href={ctaHref} class="btn btn-primary btn-lg">{ctaLabel}</a>
      <div class="pt-meta">
        <span>Month to month. No contracts.</span>
        <span class="pt-meta-sep" aria-hidden="true">·</span>
        <span><span class="stars">★★★★★</span> 5.0 on Google</span>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-offer {
    margin-top: 72px;
    padding: 56px 0 64px;
    background: #fff;
    border-top: 1px solid var(--hairline);
  }

  .pt-head {
    text-align: center;
  }

  .pt-head h2 {
    margin-top: 10px;
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .pt-head p {
    margin-top: 10px;
    font-size: 16px;
    color: var(--muted);
  }

  .pt-table {
    --pt-tint: #fdf5ef;
    max-width: 1064px;
    margin: 40px auto 0;
    display: grid;
    grid-template-columns: 140px repeat(3, 1fr);
    grid-template-rows: repeat(6, auto);
    font-size: 15px;
  }

  .pt-labels,
  .pt-col {
    grid-row: 1 / span 6;
    display: grid;
    grid-template-rows: subgrid;
  }

  .pt-label {
    padding: 22px 0;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--muted-3);
  }

  .pt-name {
    align-self: end;
    padding: 34px 24px 20px;
    text-align: center;
    font-size: 21px;
    font-weight: 800;
  }

  .pt-featured .pt-name {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 14px 24px 20px;
    background: var(--orange);
    color: #fff;
    border-radius: 18px 18px 0 0;
  }

  .pt-badge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    opacity: 0.9;
    white-space: nowrap;
    margin-bottom: 6px;
  }

  .pt-cell {
    padding: 22px 16px;
    border-top: 1px solid var(--hairline);
    text-align: center;
  }

  .pt-featured .pt-cell {
    background: var(--pt-tint);
  }

  .pt-featured .pt-last {
    border-radius: 0 0 18px 18px;
  }

  .pt-at {
    font-weight: 700;
    color: var(--orange-hover);
  }

  .pt-prefix,
  .pt-unit {
    font-size: 15px;
    font-weight: 700;
  }

  .pt-prefix {
    color: var(--muted);
  }

  .pt-unit {
    color: var(--muted-3);
  }

  div.pt-unit {
    font-size: 14px;
    white-space: nowrap;
  }

  .pt-amount {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .pt-gets {
    line-height: 1.55;
    text-wrap: balance;
  }

  .pt-list {
    line-height: 1.9;
    color: var(--body);
  }

  .pt-list b {
    color: var(--ink);
  }

  .pt-list a {
    color: var(--orange);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pt-muted {
    color: var(--muted-3);
  }

  .pt-foot {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .pt-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
  }

  .stars {
    color: var(--orange);
    letter-spacing: 1px;
  }

  /* MOBILE TABS + CARD */
  .pm {
    display: none;
  }

  .pm-radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .pm-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    margin-top: 28px;
    padding: 4px;
    background: #f3f3f5;
    border-radius: var(--radius-pill);
  }

  .pm-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 4px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 800;
    color: var(--body);
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.15s, color 0.15s;
  }

  .pm-hint {
    margin-top: 10px;
    text-align: center;
    font-size: 13px;
    color: var(--muted-3);
  }

  .pm-card {
    display: none;
    position: relative;
    margin-top: 20px;
    padding: 28px 22px 24px;
    border: 1px solid var(--border);
    border-radius: 22px;
  }

  .pm-featured {
    margin-top: 30px;
    border: 2px solid var(--orange);
  }

  .pm-badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--orange);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .pm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .pm-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pm-num {
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--orange);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pm-name {
    font-size: 21px;
    font-weight: 800;
  }

  .pm-rev {
    padding: 6px 11px;
    border-radius: var(--radius-pill);
    background: #fdf0e8;
    color: var(--orange-hover);
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .pm-price {
    margin-top: 22px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pm-prefix,
  .pm-unit {
    font-size: 16px;
    font-weight: 700;
  }

  .pm-prefix {
    color: var(--muted);
  }

  .pm-unit {
    color: var(--muted-3);
  }

  .pm-amount {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .pm-price-sub {
    margin-top: 6px;
    font-size: 15px;
    color: var(--muted);
  }

  .pm-goal {
    margin-top: 20px;
    padding: 16px 18px;
    background: #fdf5ef;
    border-radius: 14px;
  }

  .pm-goal-label,
  .pm-label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .pm-goal-label {
    color: var(--orange-hover);
  }

  .pm-goal-text {
    margin-top: 6px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.45;
  }

  .pm-label {
    margin-top: 22px;
    color: var(--muted-3);
  }

  .pm-label-top {
    padding-top: 18px;
    border-top: 1px solid var(--hairline);
  }

  .pm-included {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
  }

  .pm-included li {
    display: flex;
    gap: 10px;
  }

  .pm-check {
    color: var(--orange);
    font-weight: 800;
  }

  .pm-extras {
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pm-extra {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 16px;
  }

  .pm-extra-label {
    color: var(--body);
  }

  .pm-extra-label a {
    color: var(--orange);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pm-extra-note {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    color: var(--muted-3);
  }

  .pm-extra b {
    white-space: nowrap;
  }

  .pm-dots {
    margin-top: 18px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .pm-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: #d9d9d9;
    cursor: pointer;
    transition: width 0.2s, background 0.2s;
  }

  #pm-stage-0:checked ~ .pm-tabs .pm-tab:nth-child(1),
  #pm-stage-1:checked ~ .pm-tabs .pm-tab:nth-child(2),
  #pm-stage-2:checked ~ .pm-tabs .pm-tab:nth-child(3) {
    background: var(--dark);
    color: #fff;
  }

  #pm-stage-0:focus-visible ~ .pm-tabs .pm-tab:nth-child(1),
  #pm-stage-1:focus-visible ~ .pm-tabs .pm-tab:nth-child(2),
  #pm-stage-2:focus-visible ~ .pm-tabs .pm-tab:nth-child(3) {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  #pm-stage-0:checked ~ .pm-cards .pm-card:nth-child(1),
  #pm-stage-1:checked ~ .pm-cards .pm-card:nth-child(2),
  #pm-stage-2:checked ~ .pm-cards .pm-card:nth-child(3) {
    display: block;
  }

  #pm-stage-0:checked ~ .pm-dots .pm-dot:nth-child(1),
  #pm-stage-1:checked ~ .pm-dots .pm-dot:nth-child(2),
  #pm-stage-2:checked ~ .pm-dots .pm-dot:nth-child(3) {
    width: 22px;
    background: var(--orange);
  }

  @media (max-width: 900px) {
    .pt-table {
      display: none;
    }

    .pm {
      display: block;
      max-width: 440px;
      margin: 0 auto;
    }

    .pt-head h2 {
      font-size: 30px;
    }

    .pt-foot {
      margin-top: 26px;
    }

    .pt-foot .btn {
      width: 100%;
      max-width: 440px;
      padding: 18px 24px;
      font-size: 17px;
    }

    .pt-meta {
      flex-direction: column;
      align-items: center;
    }

    .pt-meta-sep {
      display: none;
    }
  }
</style>
