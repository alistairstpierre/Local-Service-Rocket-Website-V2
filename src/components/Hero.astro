---
/* Hero carousel: lazy-susan client images with frosted stats card.
   Auto-advances every 6.5s. Client script below mounts the interactive behavior.
   Used at the top of the homepage (replaces Hero Section.dc.html). */
---

<section class="hero">
  <div class="hero-grid container">
    <div class="hero-copy">
      <div class="hero-badges">
        <img
          src="/assets/badge-google-partner.png"
          alt="Google Partner"
          class="partner-badge"
          width="120"
          height="34"
        />
        <div class="rating-badge">
          <span class="stars">★★★★★</span>
          <span class="rating-text">5.0 on Google</span>
        </div>
      </div>
      <h1>Real growth, real fast — for home service companies ready to scale.</h1>
      <p class="hero-sub">
        Marketing, recruiting, &amp; AI systems — so you can build a bigger team and a name your
        whole city recognizes.
      </p>
      <div class="hero-ctas">
        <a href="#case-studies" class="btn btn-primary">See client results</a>
        <a href="/get-started" class="btn btn-secondary">How it works</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="carousel-stage" id="hero-carousel" aria-live="polite">
        <!-- Slides injected by script for transition control -->
        <div class="carousel-slides" id="carousel-slides"></div>
        <div class="carousel-fade" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <div class="stats-band">
    <div class="stats-grid container">
      <div>
        <div class="stat-num">6</div>
        <div class="stat-label">home service companies scaled — every one named on this page</div>
      </div>
      <div>
        <div class="stat-num orange">$10M+</div>
        <div class="stat-label">in new revenue generated for our clients</div>
      </div>
      <div>
        <div class="stat-num">10 days</div>
        <div class="stat-label">on average to bring a client qualified hiring candidates</div>
      </div>
      <div>
        <div class="stat-num">$0 → $200k/mo</div>
        <div class="stat-label">one client's first 6 months, from launch to today</div>
      </div>
    </div>
  </div>
</section>

<script>
  // Hero carousel logic ported from Hero Section.dc.html Component class.
  type Client = {
    name: string;
    since: string;
    img: string;
    stats: [string, string][];
  };

  const clients: Client[] = [
    {
      name: 'Rewired Iowa',
      since: 'Client for 2 years',
      img: '/assets/client-rewired.png',
      stats: [
        ['STARTED', '5 techs'],
        ['TODAY', '15 techs'],
        ['MONTHLY REV', '$60k → $220k+'],
      ],
    },
    {
      name: 'Motha Electric',
      since: '46+ years in business',
      img: '/assets/client-motha-electric.png',
      stats: [
        ['LEADS / DAY', '0 → 3'],
        ['MONTHLY REV', '$60k, steady'],
        ['THE GOAL', 'Consistency'],
      ],
    },
    {
      name: 'Honest Hanks',
      since: 'Client for 8 months',
      img: '/assets/client-honest-hanks.png',
      stats: [
        ['STARTED', '1 tech'],
        ['TODAY', '3 techs'],
        ['MONTHLY REV', '$25k → $80k'],
      ],
    },
    {
      name: 'Hooked Up Electric',
      since: 'Client for 1.5 years',
      img: '/assets/client-hooked-up.png',
      stats: [
        ['YEAR ONE', '600% growth'],
        ['COUNTIES', '1 → 37'],
        ['LOCATIONS', '1 → 4'],
      ],
    },
    {
      name: 'Dry Duck',
      since: 'Founded together 6 months ago',
      img: '/assets/client-dry-duck.png',
      stats: [
        ['MONTHLY REV', '$200k'],
        ['TEAM', '5 employees'],
        ['SCOPE', 'Brand + marketing'],
      ],
    },
  ];

  const root = document.getElementById('carousel-slides');
  if (root) {
    let idx = 0;
    let prev = -1;

    function render() {
      if (!root) return;
      root.innerHTML = clients
        .map((c, i) => {
          const active = i === idx;
          const leaving = i === prev;
          const x = active ? '0' : leaving ? '-950px' : '620px';
          const transition = active || leaving ? 'transform 1.1s ease-in-out' : 'none';
          const visibility = active || leaving ? 'visible' : 'hidden';
          const statsHtml = c.stats
            .map(
              (s, k) => `
            <div>
              <div class="slide-stat-label${k === 1 ? ' accent' : ''}">${s[0]}</div>
              <div class="slide-stat-value${k === 1 ? ' accent' : ''}">${s[1]}</div>
            </div>`
            )
            .join('');

          return `
          <div class="carousel-slide" style="transform:translateX(${x});transition:${transition};visibility:${visibility}">
            <div class="slide-img-wrap">
              <img src="${c.img}" alt="${c.name}" class="slide-img" height="430" />
            </div>
            <div class="slide-card">
              <div class="slide-card-meta">
                <div class="slide-name">${c.name}</div>
                <div class="slide-since">${c.since}</div>
              </div>
              ${statsHtml}
            </div>
          </div>`;
        })
        .join('');
    }

    render();
    setInterval(() => {
      prev = idx;
      idx = (idx + 1) % clients.length;
      render();
    }, 6500);
  }
</script>

<style>
  .hero {
    background: #fff;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 36px;
    padding-top: 48px;
    padding-bottom: 40px;
    align-items: center;
    position: relative;
  }

  .hero-copy {
    position: relative;
    z-index: 5;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .partner-badge {
    height: 34px;
    width: auto;
    border-radius: 6px;
    border: 1px solid #e5e5e5;
  }

  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px;
    border-radius: 6px;
    border: 1px solid #e5e5e5;
    background: #fff;
  }

  .stars {
    color: var(--orange);
    font-size: 12px;
    letter-spacing: 1px;
  }

  .rating-text {
    font-size: 11.5px;
    font-weight: 800;
    color: var(--ink);
  }

  .hero-copy h1 {
    margin-top: 18px;
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-sub {
    margin-top: 16px;
    max-width: 380px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .hero-visual {
    min-width: 0;
  }

  .carousel-stage {
    position: relative;
    height: 440px;
    overflow: hidden;
    margin-left: -360px;
    margin-right: calc(var(--pad-x) * -1);
  }

  .carousel-slides {
    position: absolute;
    inset: 0;
  }

  .carousel-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 265px;
    background: linear-gradient(
      90deg,
      #fff 55%,
      rgba(255, 255, 255, 0.7) 78%,
      rgba(255, 255, 255, 0)
    );
    z-index: 3;
    pointer-events: none;
  }

  :global(.carousel-slide) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  :global(.slide-img-wrap) {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 150px;
    display: flex;
    align-items: center;
  }

  :global(.slide-img) {
    display: block;
    height: 430px;
    width: auto;
    max-width: none;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%),
      linear-gradient(0deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image:
      linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%),
      linear-gradient(0deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  :global(.slide-card) {
    position: absolute;
    bottom: 26px;
    right: 40px;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(26, 26, 26, 0.08);
    border-radius: 14px;
    padding: 14px 20px;
    color: var(--ink);
    display: flex;
    gap: 22px;
    align-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    z-index: 4;
  }

  :global(.slide-card-meta) {
    padding-right: 20px;
    border-right: 1px solid rgba(26, 26, 26, 0.12);
  }

  :global(.slide-name) {
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.slide-since) {
    font-size: 10px;
    color: var(--muted);
    margin-top: 2px;
    white-space: nowrap;
  }

  :global(.slide-stat-label) {
    font-size: 8.5px;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  :global(.slide-stat-label.accent),
  :global(.slide-stat-value.accent) {
    color: var(--orange);
  }

  :global(.slide-stat-value) {
    font-size: 15px;
    font-weight: 800;
    margin-top: 1px;
    white-space: nowrap;
    color: var(--ink);
  }

  .stats-band {
    border-top: 1px solid var(--hairline);
    background: var(--section-bg);
  }

  .stats-grid {
    padding-top: 26px;
    padding-bottom: 26px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }

  .stat-num {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .stat-num.orange {
    color: var(--orange);
  }

  .stat-label {
    font-size: 12.5px;
    color: var(--muted-2);
    margin-top: 2px;
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .carousel-stage {
      margin-left: 0;
      margin-right: 0;
      height: 360px;
    }

    :global(.slide-img-wrap) {
      right: 20px;
      left: 20px;
      justify-content: center;
    }

    :global(.slide-img) {
      height: 320px;
    }

    :global(.slide-card) {
      right: 16px;
      left: 16px;
      bottom: 16px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .carousel-fade {
      display: none;
    }

    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
