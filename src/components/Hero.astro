---
/* Hero carousel: lazy-susan client images with frosted stats card.
   Auto-advances every 6.5s. Slides are rendered server-side (so the first
   image is discoverable as the LCP element) and the client script below only
   drives the transitions. Used on `/` (electrician-led) and
   `/marketing-for-service-companies` (all trades). */
import Picture from './Picture.astro';

type Client = {
  name: string;
  since: string;
  img: string;
  stats: [string, string][];
  electrical?: boolean;
};

type Stat = { num: string; label: string; orange?: boolean };

interface Props {
  h1?: string;
  sub?: string;
  /** Electrical-only carousel (homepage). Default: all clients including Dry Duck. */
  focus?: 'electrical' | 'all';
  stats?: Stat[];
}

const {
  h1 = 'Real growth, real fast for home service companies ready to scale.',
  sub = 'Marketing, recruiting, and AI systems so you can build a bigger team and a name your whole city recognizes.',
  focus = 'all',
  stats: statsProp,
} = Astro.props;

/* Motha Electric is our weakest story. Always last in any client list. */
const allClients: Client[] = [
  {
    name: 'Rewired Iowa',
    since: 'Client for 2 years',
    img: 'client-rewired',
    electrical: true,
    stats: [
      ['STARTED', '5 techs'],
      ['TODAY', '12 techs'],
      ['MONTHLY REV', '$60k → $220k+'],
    ],
  },
  {
    name: 'Honest Hanks',
    since: 'Client for 8 months',
    img: 'client-honest-hanks',
    electrical: true,
    stats: [
      ['STARTED', '1 tech'],
      ['TODAY', '3 techs'],
      ['MONTHLY REV', '$25k → $80k'],
    ],
  },
  {
    name: 'Hooked Up Electric',
    since: 'Client for 1.5 years',
    img: 'client-hooked-up',
    electrical: true,
    stats: [
      ['YEAR ONE', '600% growth'],
      ['COUNTIES', '1 → 37'],
      ['LOCATIONS', '1 → 4'],
    ],
  },
  {
    name: 'Dry Duck',
    since: 'Founded together 6 months ago',
    img: 'client-dry-duck',
    electrical: false,
    stats: [
      ['MONTHLY REV', '$200k'],
      ['TEAM', '5 employees'],
      ['SCOPE', 'Brand + marketing'],
    ],
  },
  {
    name: 'Motha Electric',
    since: '46+ years in business',
    img: 'client-motha-electric',
    electrical: true,
    stats: [
      ['LEADS / DAY', '0 → 3'],
      ['MONTHLY REV', '$60k, steady'],
      ['THE GOAL', 'Consistency'],
    ],
  },
];

const clients =
  focus === 'electrical' ? allClients.filter((c) => c.electrical) : allClients;

const bandStats: Stat[] =
  statsProp ??
  (focus === 'electrical'
    ? [
        { num: '4+', label: 'electrical companies grown with named results on this page' },
        { num: '$10M+', label: 'in new revenue generated for our clients', orange: true },
        { num: '10 days', label: 'on average to bring qualified electrician hiring candidates' },
        { num: '$60k → $220k+', label: 'Rewired monthly revenue while we kept running Google' },
      ]
    : [
        { num: '6', label: 'home service companies scaled (every one named on this page)' },
        { num: '$10M+', label: 'in new revenue generated for our clients', orange: true },
        { num: '10 days', label: 'on average to bring a client qualified hiring candidates' },
        { num: '$0 → $200k/mo', label: "one client's first 6 months, from launch to today" },
      ]);

// Matches ENTER_X in the transition script below.
const ENTER_X = '620px';
---

<section class="hero">
  <div class="hero-grid container">
    <div class="hero-copy">
      <div class="hero-badges">
        <div class="rating-badge">
          <span class="stars">★★★★★</span>
          <span class="rating-text">5.0 on Google</span>
        </div>
      </div>
      <h1>{h1}</h1>
      <p class="hero-sub">{sub}</p>
      <div class="hero-ctas">
        <a href="/get-started" class="btn btn-primary">Schedule onboarding</a>
        <a href="#case-studies" class="btn btn-secondary">See client results</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="carousel-stage" id="hero-carousel" aria-live="polite">
        <div class="carousel-slides" id="carousel-slides">
          {
            clients.map((client, i) => (
              <div
                class="carousel-slide"
                data-slide={i}
                style={`transform:translateX(${i === 0 ? '0' : ENTER_X});visibility:${i === 0 ? 'visible' : 'hidden'}`}
              >
                <div class="slide-img-wrap">
                  <Picture
                    name={client.img}
                    alt={client.name}
                    class="slide-img"
                    width={430}
                    height={430}
                    sizes="(max-width: 1000px) 320px, 430px"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'low'}
                  />
                </div>
                <div class="slide-card">
                  <div class="slide-card-meta">
                    <div class="slide-name">{client.name}</div>
                    <div class="slide-since">{client.since}</div>
                  </div>
                  {client.stats.map(([label, value], k) => (
                    <div>
                      <div class={k === 1 ? 'slide-stat-label accent' : 'slide-stat-label'}>
                        {label}
                      </div>
                      <div class={k === 1 ? 'slide-stat-value accent' : 'slide-stat-value'}>
                        {value}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="carousel-fade" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <div class="stats-band">
    <div class="stats-grid container">
      {
        bandStats.map((s) => (
          <div>
            <div class={s.orange ? 'stat-num orange' : 'stat-num'}>{s.num}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Slides are server-rendered; this only animates transforms between them.
  const DURATION_MS = 1100;
  const INTERVAL_MS = 6500;
  const ENTER_X = '620px';
  const EXIT_X = '-950px';

  const root = document.getElementById('carousel-slides');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduceMotion) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.carousel-slide'));
    let idx = 0;
    let animating = false;

    function goNext() {
      if (animating) return;
      animating = true;

      const prev = idx;
      idx = (idx + 1) % slides.length;
      const outgoing = slides[prev];
      const incoming = slides[idx];

      // Park incoming off-screen right with no transition, then animate in.
      incoming.style.transition = 'none';
      incoming.style.transform = `translateX(${ENTER_X})`;
      incoming.style.visibility = 'visible';
      void incoming.offsetWidth;

      incoming.style.transition = `transform ${DURATION_MS}ms ease-in-out`;
      incoming.style.transform = 'translateX(0)';

      outgoing.style.visibility = 'visible';
      outgoing.style.transition = `transform ${DURATION_MS}ms ease-in-out`;
      outgoing.style.transform = `translateX(${EXIT_X})`;

      window.setTimeout(() => {
        outgoing.style.transition = 'none';
        outgoing.style.transform = `translateX(${ENTER_X})`;
        outgoing.style.visibility = 'hidden';
        animating = false;
      }, DURATION_MS);
    }

    // Slides 2+ are deferred so they never compete with the LCP image, but they
    // must be decoded before their turn comes around: warm them once idle.
    const warmSlides = () => {
      root.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => {
        img.loading = 'eager';
      });
    };
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(warmSlides);
    } else {
      window.setTimeout(warmSlides, 1500);
    }

    let timer = window.setInterval(goNext, INTERVAL_MS);

    // No point animating in a background tab.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        window.clearInterval(timer);
      } else {
        timer = window.setInterval(goNext, INTERVAL_MS);
      }
    });
  }
</script>

<style>
  .hero {
    background: #fff;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 36px;
    padding-top: 48px;
    padding-bottom: 40px;
    align-items: center;
    position: relative;
  }

  .hero-copy {
    position: relative;
    z-index: 5;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* :global() because <Picture> renders the <img> from a child component. */
  :global(.partner-badge) {
    height: 34px;
    width: auto;
    border-radius: 6px;
    border: 1px solid #e5e5e5;
  }

  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px;
    border-radius: 6px;
    border: 1px solid #e5e5e5;
    background: #fff;
  }

  .stars {
    color: var(--orange);
    font-size: 13px;
    letter-spacing: 1px;
  }

  .rating-text {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--ink);
  }

  .hero-copy h1 {
    margin-top: 18px;
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-sub {
    margin-top: 16px;
    max-width: 380px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .hero-visual {
    min-width: 0;
  }

  .carousel-stage {
    position: relative;
    height: 440px;
    overflow: hidden;
    margin-left: -360px;
    margin-right: calc(var(--pad-x) * -1);
  }

  .carousel-slides {
    position: absolute;
    inset: 0;
  }

  .carousel-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 265px;
    background: linear-gradient(
      90deg,
      #fff 55%,
      rgba(255, 255, 255, 0.7) 78%,
      rgba(255, 255, 255, 0)
    );
    z-index: 3;
    pointer-events: none;
  }

  :global(.carousel-slide) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
    will-change: transform;
  }

  :global(.slide-img-wrap) {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 150px;
    display: flex;
    align-items: center;
  }

  :global(.slide-img) {
    display: block;
    height: 430px;
    width: 430px;
    max-width: none;
    object-fit: contain;
    object-position: center bottom;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%),
      linear-gradient(0deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image:
      linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%),
      linear-gradient(0deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  :global(.slide-card) {
    position: absolute;
    bottom: 26px;
    right: 40px;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(26, 26, 26, 0.08);
    border-radius: 14px;
    padding: 14px 20px;
    color: var(--ink);
    display: flex;
    gap: 22px;
    align-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    z-index: 4;
  }

  :global(.slide-card-meta) {
    padding-right: 20px;
    border-right: 1px solid rgba(26, 26, 26, 0.12);
  }

  :global(.slide-name) {
    font-size: 14px;
    font-weight: 800;
    white-space: nowrap;
  }

  :global(.slide-since) {
    font-size: 11px;
    color: var(--muted);
    margin-top: 2px;
    white-space: nowrap;
  }

  :global(.slide-stat-label) {
    font-size: 9.5px;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  :global(.slide-stat-label.accent),
  :global(.slide-stat-value.accent) {
    color: var(--orange);
  }

  :global(.slide-stat-value) {
    font-size: 16px;
    font-weight: 800;
    margin-top: 1px;
    white-space: nowrap;
    color: var(--ink);
  }

  .stats-band {
    border-top: 1px solid var(--hairline);
    background: var(--section-bg);
  }

  .stats-grid {
    padding-top: 26px;
    padding-bottom: 26px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }

  .stat-num {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .stat-num.orange {
    color: var(--orange);
  }

  .stat-label {
    font-size: 13.5px;
    color: var(--muted-2);
    margin-top: 2px;
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .carousel-stage {
      margin-left: 0;
      margin-right: 0;
      height: 360px;
    }

    :global(.slide-img-wrap) {
      right: 20px;
      left: 20px;
      justify-content: center;
    }

    :global(.slide-img) {
      height: 320px;
      width: 320px;
    }

    :global(.slide-card) {
      right: 16px;
      left: 16px;
      bottom: 16px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .carousel-fade {
      display: none;
    }

    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
