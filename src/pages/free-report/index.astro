---
/* Free Google report lead magnet. Collects email + city, searches GET /api/places
   for the Google listing, then POSTs placeId to the Railway analysis API and
   sends the visitor to /free-report/view/?id= to poll. Vendor keys stay on
   Railway; this static page only knows PUBLIC_ANALYSIS_API_URL. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, breadcrumbList, graph, webPageNode } from '../../data/schema';

const title = 'Free Google Report for Electricians | Local Service Rocket';
const description =
  'See how your electrician Google Business Profile, website, ads, and AI search rankings stack up against the Map Pack. Enter your shop and get a free comparison report.';
const pageUrl = absoluteUrl('/free-report/');
const jsonLd = graph([
  webPageNode({ pageUrl, name: title, description }),
  breadcrumbList(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Free Google report', path: '/free-report' },
  ]),
]);

const apiUrl = (import.meta.env.PUBLIC_ANALYSIS_API_URL || '').replace(/\/$/, '');
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="report">
    <section class="hero container">
      <div class="crumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span class="current">Free Google report</span>
      </div>
      <div class="eyebrow">FREE LEAD MAGNET</div>
      <h1>See why the other electrician is ranking above you.</h1>
      <p class="lede">
        For electrician shops only, for now. We pull your Google Business Profile, website, ads,
        and AI search rankings, then compare you with the electricians in the Map Pack. No sales
        call. After you submit, you go straight to the report — it fills in as we pull each
        section. We also email a copy.
      </p>
    </section>

    <section class="panel container">
      <div class="copy">
        <h2>What the report covers</h2>
        <ul class="bullets">
          <li>Map Pack position and Google profile completeness</li>
          <li>Reviews and how fast they are coming in</li>
          <li>Website SEO, schema, and mobile speed</li>
          <li>Whether you or competitors show in LSAs and Search Ads</li>
          <li>Whether ChatGPT or Gemini names you for the money search</li>
        </ul>
        <p class="alt">
          Already know you want help? <a href="/get-started">Schedule onboarding</a>.
        </p>
      </div>

      <div class="form-wrap">
        {
          !apiUrl && (
            <p class="config-warn" role="status">
              The report API is not wired yet. Set PUBLIC_ANALYSIS_API_URL (see README) or email
              <a href="mailto:hello@localservicerocket.com">hello@localservicerocket.com</a>.
            </p>
          )
        }
        <form id="report-form" class="form" novalidate data-api-url={apiUrl}>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required maxlength="160" />
            <span class="field-error" data-for="email" hidden></span>
          </label>
          <label>
            <span>City and state</span>
            <input type="text" name="city" id="city-input" autocomplete="address-level2" required minlength="2" maxlength="120" placeholder="Tampa, FL" />
            <span class="field-error" data-for="city" hidden></span>
          </label>
          <div class="search">
            <label>
              <span>Your Google listing</span>
              <input type="text" name="businessName" id="biz-input" autocomplete="off" required minlength="2" maxlength="120" placeholder="Start typing the shop name" />
              <span class="field-error" data-for="businessName" hidden></span>
            </label>
            <input type="hidden" name="placeId" id="place-id" />
            <div id="biz-picked" class="picked" hidden></div>
            <ul id="biz-results" class="results" hidden></ul>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="report-fax">Fax</label>
            <input type="text" id="report-fax" name="fax_number" tabindex="-1" autocomplete="off" />
          </div>
          <p class="privacy">
            You’ll land on the report next. We also email the link. We never sell your info. See the
            <a href="/privacy">privacy policy</a>.
          </p>
          <button type="submit" class="btn btn-primary btn-lg" id="submit-btn" disabled={!apiUrl}>
            Get my free report
          </button>
          <p class="status" id="form-status" role="status" hidden></p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  type PlaceHit = {
    placeId: string;
    name: string;
    rating?: number;
    reviewCount?: number;
    category?: string;
    address?: string;
  };

  const form = document.getElementById('report-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const cityInput = document.getElementById('city-input') as HTMLInputElement | null;
  const bizInput = document.getElementById('biz-input') as HTMLInputElement | null;
  const placeInput = document.getElementById('place-id') as HTMLInputElement | null;
  const resultsEl = document.getElementById('biz-results');
  const pickedEl = document.getElementById('biz-picked');
  if (!form || !cityInput || !bizInput || !placeInput || !resultsEl || !pickedEl) {
    throw new Error('Report form missing');
  }

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  let timer = 0;
  let searchSeq = 0;

  function esc(value: string): string {
    return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function hideResults() {
    resultsEl.hidden = true;
    resultsEl.innerHTML = '';
  }

  function clearPick() {
    placeInput.value = '';
    pickedEl.hidden = true;
    pickedEl.innerHTML = '';
    bizInput.hidden = false;
  }

  function pickPlace(hit: PlaceHit) {
    placeInput.value = hit.placeId;
    bizInput.value = hit.name;
    bizInput.hidden = true;
    pickedEl.hidden = false;
    const bits = [hit.category, hit.address].filter(Boolean).join(' · ');
    const rating = hit.rating ? `${hit.rating.toFixed(1)}★${hit.reviewCount ? ` (${hit.reviewCount})` : ''}` : '';
    pickedEl.innerHTML = `<div><strong>${esc(hit.name)}</strong>${rating ? `<span>${esc(rating)}</span>` : ''}${bits ? `<span>${esc(bits)}</span>` : ''}</div><button type="button" class="picked-clear">Change</button>`;
    hideResults();
    pickedEl.querySelector('button')?.addEventListener('click', () => {
      clearPick();
      bizInput.focus();
    });
  }

  async function searchPlaces() {
    const apiUrl = form.dataset.apiUrl || '';
    const q = bizInput.value.trim();
    const city = cityInput.value.trim();
    if (!apiUrl || q.length < 2 || city.length < 2) {
      hideResults();
      return;
    }
    const seq = ++searchSeq;
    resultsEl.hidden = false;
    resultsEl.innerHTML = '<li class="results-status">Searching Google listings…</li>';
    try {
      const res = await fetch(
        `${apiUrl}/api/places?q=${encodeURIComponent(q)}&city=${encodeURIComponent(city)}`
      );
      const json = await res.json();
      if (seq !== searchSeq) return;
      if (!res.ok) throw new Error(json.error || 'Search failed');
      const hits = (json.results || []) as PlaceHit[];
      if (!hits.length) {
        resultsEl.innerHTML = '<li class="results-status">No listing found. Keep typing, or submit the name as written.</li>';
        return;
      }
      resultsEl.innerHTML = hits
        .map(
          (hit) =>
            `<li><button type="button"><strong>${esc(hit.name)}</strong><span>${esc([hit.rating ? `${hit.rating.toFixed(1)}★` : '', hit.address || hit.category].filter(Boolean).join(' · '))}</span></button></li>`
        )
        .join('');
      resultsEl.querySelectorAll('button').forEach((btn, i) => {
        btn.addEventListener('click', () => {
          const hit = hits[i];
          if (hit) pickPlace(hit);
        });
      });
    } catch (err) {
      if (seq !== searchSeq) return;
      resultsEl.innerHTML = `<li class="results-status">${err instanceof Error ? err.message : 'Search failed'}</li>`;
    }
  }

  bizInput.addEventListener('input', () => {
    if (placeInput.value) clearPick();
    window.clearTimeout(timer);
    timer = window.setTimeout(searchPlaces, 350);
  });
  cityInput.addEventListener('input', () => {
    if (placeInput.value) clearPick();
    if (bizInput.value.trim().length >= 2) {
      window.clearTimeout(timer);
      timer = window.setTimeout(searchPlaces, 350);
    }
  });
  document.addEventListener('click', (event) => {
    if (!form.contains(event.target as Node)) hideResults();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const apiUrl = form.dataset.apiUrl || '';
    const data = new FormData(form);
    if (String(data.get('fax_number') || '')) return;

    const payload = {
      email: String(data.get('email') || '').trim(),
      businessName: String(data.get('businessName') || '').trim(),
      city: String(data.get('city') || '').trim(),
      placeId: String(data.get('placeId') || '').trim() || undefined,
    };

    const errors: Record<string, string> = {};
    if (!EMAIL_RE.test(payload.email)) errors.email = 'Enter a valid email.';
    if (payload.city.length < 2) errors.city = 'Enter a city and state.';
    if (payload.businessName.length < 2) errors.businessName = 'Search for your Google listing.';
    form.querySelectorAll<HTMLElement>('.field-error').forEach((el) => {
      const key = el.dataset.for;
      if (key && errors[key]) {
        el.hidden = false;
        el.textContent = errors[key];
      } else {
        el.hidden = true;
        el.textContent = '';
      }
    });
    if (Object.keys(errors).length || !apiUrl) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Starting your report…';
    }
    if (statusEl) {
      statusEl.hidden = false;
      statusEl.textContent = 'Opening your report…';
    }

    try {
      const res = await fetch(`${apiUrl}/api/reports`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Could not start the report.');
      window.location.href = `/free-report/view/?id=${encodeURIComponent(json.id)}`;
    } catch (err) {
      if (statusEl) {
        statusEl.textContent = err instanceof Error ? err.message : 'Could not start the report.';
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Get my free report';
      }
    }
  });
</script>

<style>
  .hero { padding-top: 48px; padding-bottom: 20px; }
  .crumbs { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--muted-3); }
  .crumbs a { color: var(--muted-3); }
  .current { color: var(--ink); font-weight: 600; }
  .eyebrow { margin-top: 22px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; color: var(--orange); }
  h1 { margin-top: 12px; font-size: clamp(28px, 4vw, 42px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; max-width: 16ch; }
  .lede { margin-top: 16px; font-size: 17.5px; line-height: 1.65; color: var(--body); max-width: 58ch; }
  .panel { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 40px 48px; padding-bottom: 72px; }
  .copy h2 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
  .bullets { margin: 18px 0 0; padding-left: 1.15em; color: var(--body); line-height: 1.65; }
  .bullets li + li { margin-top: 10px; }
  .alt { margin-top: 18px; color: var(--muted); font-size: 14px; }
  .form-wrap { border: 1px solid var(--border); border-radius: var(--radius-panel); background: #fff; padding: 28px; box-shadow: 0 12px 40px rgba(26, 26, 26, 0.04); }
  .form { display: flex; flex-direction: column; gap: 16px; }
  label { display: flex; flex-direction: column; gap: 6px; }
  label span { font-size: 13px; font-weight: 700; }
  label em { font-style: normal; font-weight: 500; color: var(--muted-3); }
  input { width: 100%; border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; font: inherit; }
  input:focus { outline: none; border-color: var(--orange); }
  .field-error { font-size: 12.5px; color: #b42318; }
  .search { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .results { list-style: none; margin: 0; padding: 6px; border: 1px solid var(--border); border-radius: 10px; background: #fff; box-shadow: 0 10px 28px rgba(26, 26, 26, 0.08); max-height: 280px; overflow: auto; }
  .results li + li { border-top: 1px solid #f1f1f1; }
  .results button { width: 100%; border: 0; background: none; text-align: left; padding: 10px 12px; font: inherit; cursor: pointer; border-radius: 8px; }
  .results button:hover, .results button:focus { background: #fff7f1; }
  .results strong, .picked strong { display: block; font-size: 14px; }
  .results span, .picked span { display: block; font-size: 12px; color: var(--muted); margin-top: 2px; }
  .results-status { padding: 10px 12px; font-size: 13px; color: var(--muted); }
  .picked { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 12px 14px; border: 1px solid var(--orange); border-radius: 10px; background: #fff7f1; }
  .picked-clear { border: 0; background: none; color: var(--orange); font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
  .privacy { font-size: 13px; color: var(--muted); line-height: 1.5; }
  .status { font-size: 14px; color: var(--body); }
  .config-warn { margin-bottom: 16px; padding: 12px 14px; border-radius: var(--radius-card); background: var(--orange-tint); border: 1px solid rgba(232, 89, 12, 0.25); font-size: 14px; }
  .hp { position: absolute; left: -9999px; }
  @media (max-width: 900px) { .panel { grid-template-columns: 1fr; } }
</style>
