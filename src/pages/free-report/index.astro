<script>
  type PlaceHit = {
    placeId: string;
    name: string;
    rating?: number;
    reviewCount?: number;
    category?: string;
    address?: string;
  };

  const form = document.getElementById('report-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label');
  const emailInput = document.getElementById('email-input') as HTMLInputElement | null;
  const phoneInput = document.getElementById('phone-input') as HTMLInputElement | null;
  const cityInput = document.getElementById('city-input') as HTMLInputElement | null;
  const bizInput = document.getElementById('gbp-search') as HTMLInputElement | null;
  const nameInput = document.getElementById('business-name') as HTMLInputElement | null;
  const placeInput = document.getElementById('place-id') as HTMLInputElement | null;
  const resultsEl = document.getElementById('biz-results');
  const pickedEl = document.getElementById('biz-picked');
  const searchWrap = document.getElementById('search-wrap');
  const searchBlock = document.getElementById('search-block');
  const searchHint = document.getElementById('search-hint');
  if (
    !form ||
    !emailInput ||
    !phoneInput ||
    !cityInput ||
    !bizInput ||
    !nameInput ||
    !placeInput ||
    !resultsEl ||
    !pickedEl ||
    !searchWrap ||
    !searchBlock
  ) {
    throw new Error('Report form missing');
  }

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const STATE_NAME: Record<string, string> = {
    al: 'alabama', ak: 'alaska', az: 'arizona', ar: 'arkansas', ca: 'california',
    co: 'colorado', ct: 'connecticut', de: 'delaware', fl: 'florida', ga: 'georgia',
    hi: 'hawaii', id: 'idaho', il: 'illinois', in: 'indiana', ia: 'iowa',
    ks: 'kansas', ky: 'kentucky', la: 'louisiana', me: 'maine', md: 'maryland',
    ma: 'massachusetts', mi: 'michigan', mn: 'minnesota', ms: 'mississippi', mo: 'missouri',
    mt: 'montana', ne: 'nebraska', nv: 'nevada', nh: 'newhampshire', nj: 'newjersey',
    nm: 'newmexico', ny: 'newyork', nc: 'northcarolina', nd: 'northdakota', oh: 'ohio',
    ok: 'oklahoma', or: 'oregon', pa: 'pennsylvania', ri: 'rhodeisland', sc: 'southcarolina',
    sd: 'southdakota', tn: 'tennessee', tx: 'texas', ut: 'utah', vt: 'vermont',
    va: 'virginia', wa: 'washington', wv: 'westvirginia', wi: 'wisconsin', wy: 'wyoming',
  };
  const placeCache = new Map<string, PlaceHit[]>();
  const pending = new Map<string, Promise<PlaceHit[]>>();
  let timer = 0;
  let searchGen = 0;
  let hits: PlaceHit[] = [];
  let submitting = false;

  function foldText(value: string): string {
    return value.toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
  }

  function cacheKey(query: string, city: string): string {
    return `${foldText(city)}|${foldText(query)}`;
  }

  function locationTokens(city: string): Set<string> {
    const out = new Set<string>();
    for (const token of city.toLowerCase().split(/[^a-z0-9]+/).filter((part) => part.length >= 2)) {
      out.add(token);
      if (STATE_NAME[token]) out.add(STATE_NAME[token]);
    }
    for (const [abbr, name] of Object.entries(STATE_NAME)) {
      if (out.has(name)) out.add(abbr);
    }
    return out;
  }

  function searchQuery(q: string, city: string): string {
    const skip = locationTokens(city);
    return foldText(q)
      .split(/\s+/)
      .filter((word) => word.length >= 2 && !skip.has(word))
      .join(' ')
      .trim();
  }

  function queryTokens(q: string, city: string): string[] {
    return searchQuery(q, city).split(/\s+/).filter(Boolean);
  }

  function isElectricHit(hit: PlaceHit): boolean {
    return /electric/i.test(`${hit.name || ''} ${hit.category || ''}`);
  }

  function hitMatches(hit: PlaceHit, q: string, city: string): boolean {
    const tokens = queryTokens(q, city);
    if (!tokens.length) return false;
    const name = foldText(hit.name || '');
    if (tokens.every((token) => name.includes(token))) return true;
    const hay = foldText([hit.name, hit.address, hit.category].filter(Boolean).join(' '));
    return tokens.every((token) => hay.includes(token));
  }

  function rankHits(list: PlaceHit[], q: string, city: string): PlaceHit[] {
    const tokens = queryTokens(q, city);
    const joined = tokens.join(' ');
    return [...list].sort((a, b) => {
      const aName = foldText(a.name || '');
      const bName = foldText(b.name || '');
      const aElectric = isElectricHit(a) ? 0 : 1;
      const bElectric = isElectricHit(b) ? 0 : 1;
      const aStart = aName.startsWith(joined) ? 0 : 1;
      const bStart = bName.startsWith(joined) ? 0 : 1;
      return aElectric - bElectric || aStart - bStart || aName.localeCompare(bName);
    });
  }

  function cachedHits(q: string, city: string): PlaceHit[] {
    const tokens = queryTokens(q, city);
    if (!tokens.length) return [];
    const cityKey = foldText(city);
    const seen = new Set<string>();
    const out: PlaceHit[] = [];
    for (const [key, list] of placeCache) {
      if (!key.startsWith(`${cityKey}|`)) continue;
      for (const hit of list) {
        if (!hit.placeId || seen.has(hit.placeId) || !hitMatches(hit, q, city)) continue;
        seen.add(hit.placeId);
        out.push(hit);
      }
    }
    return rankHits(out, q, city);
  }

  function esc(value: string): string {
    return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function setError(message: string) {
    if (!errorEl) return;
    errorEl.hidden = !message;
    errorEl.textContent = message;
  }

  function cityReady(): boolean {
    return cityInput.value.trim().length >= 2;
  }

  function formReady(): boolean {
    return (
      Boolean(form.dataset.apiUrl) &&
      EMAIL_RE.test(emailInput.value.trim()) &&
      cityReady() &&
      Boolean(placeInput.value) &&
      (nameInput.value.trim().length >= 2 || bizInput.value.trim().length >= 2) &&
      phoneInput.value.replace(/\D/g, '').length >= 10
    );
  }

  function syncSubmit() {
    if (!submitBtn) return;
    submitBtn.disabled = submitting || !formReady();
  }

  function unlockSearch() {
    const open = cityReady();
    searchBlock.classList.toggle('locked', !open);
    if (searchHint) searchHint.hidden = open;
    if (placeInput.value) {
      searchWrap.hidden = true;
      bizInput.disabled = true;
      return;
    }
    searchWrap.hidden = !open;
    bizInput.disabled = !open;
  }

  function hideResults() {
    resultsEl.hidden = true;
    resultsEl.innerHTML = '';
    hits = [];
  }

  function clearPick() {
    placeInput.value = '';
    nameInput.value = '';
    pickedEl.hidden = true;
    pickedEl.innerHTML = '';
    bizInput.value = '';
    searchGen += 1;
    window.clearTimeout(timer);
    hideResults();
    unlockSearch();
    syncSubmit();
  }

  function metaLine(hit: PlaceHit): string {
    const rating = hit.rating ? `${hit.rating.toFixed(1)}` : '';
    const reviews = hit.reviewCount != null ? `(${hit.reviewCount.toLocaleString('en-US')})` : '';
    return [rating && `${esc(rating)} <span class="star">★</span> ${esc(reviews)}`, hit.category, hit.address]
      .filter(Boolean)
      .join(' · ');
  }

  function pickPlace(hit: PlaceHit) {
    placeInput.value = hit.placeId;
    nameInput.value = hit.name;
    bizInput.value = hit.name;
    searchWrap.hidden = true;
    pickedEl.hidden = false;
    pickedEl.innerHTML = `<div class="check" aria-hidden="true">✓</div><div class="picked-copy"><div class="picked-name">${esc(hit.name)}</div><div class="picked-meta">${metaLine(hit)}</div></div><button type="button" class="picked-clear">Change</button>`;
    hideResults();
    setError('');
    unlockSearch();
    syncSubmit();
    pickedEl.querySelector('button')?.addEventListener('click', () => {
      clearPick();
      if (cityReady()) bizInput.focus();
    });
  }

  function renderHits(list: PlaceHit[], status?: string) {
    resultsEl.hidden = false;
    const foot = status || 'Results from Google Maps';
    if (!list.length) {
      resultsEl.innerHTML = `<div class="results-status">${esc(status || 'Searching Google listings…')}</div><div class="results-foot">Results from Google Maps</div>`;
      return;
    }
    resultsEl.innerHTML =
      list
        .map(
          (hit) =>
            `<button type="button" class="hit"><span class="pin"></span><span><span class="hit-name">${esc(hit.name)}</span><span class="hit-meta">${metaLine(hit)}</span></span></button>`
        )
        .join('') + `<div class="results-foot">${esc(foot)}</div>`;
    resultsEl.querySelectorAll<HTMLButtonElement>('button.hit').forEach((btn, i) => {
      btn.addEventListener('mousedown', (event) => {
        event.preventDefault();
        const hit = list[i];
        if (hit) pickPlace(hit);
      });
    });
  }

  function paintResults(status?: string): boolean {
    const q = bizInput.value.trim();
    const city = cityInput.value.trim();
    if (!cityReady() || q.length < 2 || placeInput.value) {
      hideResults();
      return false;
    }
    const list = cachedHits(q, city);
    if (list.length) {
      hits = list;
      renderHits(list, status);
      return true;
    }
    hits = [];
    const query = searchQuery(q, city);
    renderHits([], status || (query.length < 3 ? 'Keep typing the shop name…' : 'Searching Google listings…'));
    return false;
  }

  async function pullPlaces(query: string, city: string): Promise<PlaceHit[]> {
    const key = cacheKey(query, city);
    const cached = placeCache.get(key);
    if (cached) return cached;
    const already = pending.get(key);
    if (already) return already;
    const apiUrl = form.dataset.apiUrl || '';
    if (!apiUrl) throw new Error('The report API is not wired yet.');
    const req = (async () => {
      const params = new URLSearchParams({ q: query, city });
      const res = await fetch(`${apiUrl}/api/places?${params}`);
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json.error || 'Search failed');
      const list = (json.results || []) as PlaceHit[];
      placeCache.set(key, list);
      return list;
    })();
    pending.set(key, req);
    try {
      return await req;
    } finally {
      pending.delete(key);
    }
  }

  async function pullAndPaint(query: string, city: string, gen: number) {
    try {
      const list = await pullPlaces(query, city);
      if (gen !== searchGen || placeInput.value) return;
      const q = bizInput.value.trim();
      const liveCity = cityInput.value.trim();
      if (q.length < 2) {
        hideResults();
        return;
      }
      if (liveCity.toLowerCase() !== city.toLowerCase()) return;
      if (searchQuery(q, liveCity).toLowerCase() !== query.toLowerCase()) {
        paintResults();
        return;
      }
      hits = list;
      paintResults();
    } catch (err) {
      if (gen !== searchGen) return;
      if (paintResults()) return;
      if (bizInput.value.trim().length < 2) {
        hideResults();
        return;
      }
      renderHits([], err instanceof Error ? err.message : 'Search failed');
    }
  }

  function scheduleSearch(immediate = false) {
    window.clearTimeout(timer);
    const gen = ++searchGen;
    if (placeInput.value) return;
    const q = bizInput.value.trim();
    const city = cityInput.value.trim();
    if (!cityReady() || q.length < 2) {
      hideResults();
      return;
    }
    const query = searchQuery(q, city);
    const exact = query ? placeCache.get(cacheKey(query, city)) : undefined;
    paintResults(exact ? undefined : pending.size > 0 ? 'Updating listings…' : undefined);
    if (query.length < 3) return;
    if (exact) return;
    timer = window.setTimeout(() => {
      void pullAndPaint(query, city, gen);
    }, immediate ? 0 : 200);
  }

  bizInput.addEventListener('input', () => {
    if (placeInput.value) clearPick();
    setError('');
    scheduleSearch();
    syncSubmit();
  });
  bizInput.addEventListener('focus', () => {
    if (cityReady() && bizInput.value.trim().length >= 2 && !placeInput.value) scheduleSearch(true);
  });
  cityInput.addEventListener('input', () => {
    setError('');
    if (placeInput.value) clearPick();
    unlockSearch();
    syncSubmit();
    if (cityReady() && bizInput.value.trim().length >= 2 && !placeInput.value) scheduleSearch();
    else hideResults();
  });
  emailInput.addEventListener('input', () => {
    setError('');
    syncSubmit();
  });
  phoneInput.addEventListener('input', () => {
    setError('');
    syncSubmit();
  });
  unlockSearch();
  syncSubmit();
  document.addEventListener('click', (event) => {
    if (!form.contains(event.target as Node)) hideResults();
  });
  document.getElementById('to-form')?.addEventListener('click', (event) => {
    event.preventDefault();
    document.getElementById('top')?.scrollIntoView({ behavior: 'smooth' });
    const email = form.querySelector<HTMLInputElement>('input[name="email"]');
    window.setTimeout(() => email?.focus({ preventScroll: true }), 500);
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const apiUrl = form.dataset.apiUrl || '';
    const data = new FormData(form);
    if (String(data.get('fax_number') || '')) return;

    const payload = {
      email: String(data.get('email') || '').trim(),
      businessName: nameInput.value.trim() || bizInput.value.trim() || String(data.get('businessName') || '').trim(),
      city: String(data.get('city') || '').trim(),
      phone: String(data.get('phone') || '').trim(),
      placeId: String(data.get('placeId') || '').trim() || undefined,
      smsConsent: data.get('smsConsent') === 'on',
    };

    if (!EMAIL_RE.test(payload.email)) {
      setError('Enter the email you want the report sent to.');
      return;
    }
    if (!payload.placeId) {
      setError('Pick your Google Business Profile from the list so we compare the right listing.');
      return;
    }
    if (payload.phone.replace(/\D/g, '').length < 10) {
      setError('Add a mobile number with area code.');
      return;
    }
    if (payload.city.length < 2) {
      setError('Add the business city and state so we search from the right place.');
      return;
    }
    if (!apiUrl) {
      setError('The report API is not wired yet.');
      return;
    }

    submitting = true;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.classList.add('busy');
    }
    if (submitLabel) submitLabel.textContent = 'Pulling your Google Business Profile…';
    setError('');

    try {
      const res = await fetch(`${apiUrl}/api/reports`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Could not start the report.');
      window.location.href = `/free-report/view?id=${encodeURIComponent(json.id)}`;
    } catch (err) {
      submitting = false;
      setError(err instanceof Error ? err.message : 'Could not start the report.');
      if (submitBtn) submitBtn.classList.remove('busy');
      if (submitLabel) submitLabel.textContent = 'Get my free report';
      syncSubmit();
    }
  });
</script>

