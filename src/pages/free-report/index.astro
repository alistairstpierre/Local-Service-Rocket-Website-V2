---
/* Free Google report landing. Matches Claude Design Files/Free Report - Landing.dc.html.
   Collects email, a picked Google listing, phone, city, and optional marketing-SMS consent,
   then POSTs placeId to the Railway analysis API and sends the visitor to
   /free-report/view?id= to poll. Vendor keys stay on Railway. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import { absoluteUrl, breadcrumbList, graph, webPageNode } from '../../data/schema';

const title = 'Free Google Report for Electricians | Local Service Rocket';
const description =
  'See who ranks highest for electricians in your city, and why. We put your Google Business Profile, website, and AI search next to the Map Pack.';
const pageUrl = absoluteUrl('/free-report/');
const jsonLd = graph([
  webPageNode({ pageUrl, name: title, description }),
  breadcrumbList(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Free Google report', path: '/free-report' },
  ]),
]);

const apiUrl = (
  import.meta.env.DEV ? 'http://localhost:4322' : import.meta.env.PUBLIC_ANALYSIS_API_URL || ''
).replace(/\/$/, '');

const proofLogos: { href?: string; name: string; alt: string; h: number; radius?: boolean }[] = [
  { href: '/case-studies/rewired', name: 'logo-rewired', alt: 'Rewired', h: 42 },
  { name: 'logo-motha', alt: 'Motha Electric', h: 40, radius: true },
  { href: '/case-studies/honest-hanks', name: 'logo-honest-hanks', alt: "Honest Hank's", h: 44 },
  { href: '/case-studies/hooked-up', name: 'logo-hooked-up', alt: 'Hooked Up Electric', h: 40 },
  { name: 'logo-coastal-current', alt: 'Coastal Current', h: 40 },
  { name: 'logo-pacific', alt: 'Pacific Home Electric', h: 38 },
  { name: 'logo-definite', alt: 'Definite Electric', h: 38 },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="land">
    <section class="hero" id="top">
      <div class="copy">
        <div class="pill">
          <img src="/assets/trade-electrical.svg" alt="" width="14" height="14" />
          FREE REPORT · YOU VS YOUR MAP PACK
        </div>
        <h1>See who ranks highest for electricians in your city, and why.</h1>
        <p class="lede">
          We pull your Google Business Profile, website, and AI search results and put
          them next to the three electricians in your Map Pack. Not just the order. What's
          behind it, line by line.
        </p>
        <ul class="checks">
          <li><span class="tick" aria-hidden="true">✓</span>Where you rank, and the reasons why.</li>
          <li><span class="tick" aria-hidden="true">✓</span>Who's winning the review war.</li>
          <li><span class="tick" aria-hidden="true">✓</span>Who AI recommends.</li>
        </ul>
        <div class="faces">
          <div class="stack">
            <Picture name="lewis-carter" alt="" width={34} height={34} loading="eager" />
            <Picture name="jason-hooked-up" alt="" width={34} height={34} loading="eager" />
            <Picture name="john-headshot" alt="" width={34} height={34} loading="eager" />
          </div>
          <div class="faces-copy">
            <b>The same checks we run for Rewired, Honest Hank's and Hooked Up Electric.</b>
            <br />Seven electrical shops. $10M+ in revenue.
          </div>
        </div>
      </div>

      <form id="report-form" class="card" novalidate data-api-url={apiUrl}>
        <div>
          <div class="card-title">Get your report</div>
          <div class="card-sub">20 seconds to fill in. Report builds in about 2 minutes and fills in as we go.</div>
        </div>

        <label>
          Email
          <input type="email" name="email" id="email-input" autocomplete="email" required maxlength="160" placeholder="you@yourshop.com" />
        </label>

        <label>
          Business city and state
          <input type="text" name="city" id="city-input" autocomplete="address-level2" required maxlength="120" placeholder="Tampa, FL" />
        </label>

        <div class="search locked" id="search-block">
          <label for="gbp-search">Select your Google Business Profile</label>
          <p class="search-hint" id="search-hint">Add the business city and state first so we can find the right listing.</p>
          <div id="biz-picked" class="picked" hidden></div>
          <div id="search-wrap" class="search-wrap" hidden>
            <span class="mag" aria-hidden="true"></span>
            <input
              id="gbp-search"
              type="text"
              autocomplete="off"
              maxlength="120"
              placeholder="Start typing your business name"
              disabled
            />
            <div id="biz-results" class="results" hidden></div>
          </div>
          <input type="hidden" name="businessName" id="business-name" />
          <input type="hidden" name="placeId" id="place-id" />
        </div>

        <label>
          Mobile number
          <input type="tel" name="phone" id="phone-input" autocomplete="tel" required placeholder="(813) 555-0142" />
        </label>

        <div class="hp" aria-hidden="true">
          <label for="report-fax">Fax</label>
          <input type="text" id="report-fax" name="fax_number" tabindex="-1" autocomplete="off" />
        </div>

        <label class="consent">
