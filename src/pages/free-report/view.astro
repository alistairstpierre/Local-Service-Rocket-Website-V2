  .rpt-dock-bar { height: 4px; border-radius: 99px; background: #f0f0f0; overflow: hidden; }
  .rpt-dock-bar i { display: block; height: 100%; width: 0; background: var(--orange); transition: width 0.4s ease; }
  .rpt-dock-row {
    display: flex; justify-content: space-between; gap: 16px; align-items: baseline;
    margin-top: 10px; font-size: 13.5px; font-weight: 700;
  }
  #load-now { color: #1a1a1a; }
  #load-pct { color: var(--orange); font-variant-numeric: tabular-nums; }
  .rpt-dock-steps {
    display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 8px 0 0; padding: 0; list-style: none;
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #b0b0b0;
  }
  .rpt-dock-steps .is-now { color: var(--orange); }
  .rpt-dock-steps .is-done { color: #1b8a4b; }
  .view :global(.rpt-wait) { position: relative; min-height: 160px; }
  .view :global(.rpt-wait-mask) {
    position: absolute; inset: 0; z-index: 4;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    background: rgba(255, 255, 255, 0.78); color: #1a1a1a; font-size: 14px; font-weight: 700;
    text-align: center; padding: 20px;
  }
  .view :global(.rpt-spin) {
    width: 22px; height: 22px; border-radius: 50%;
    border: 2.5px solid #f3d9c6; border-top-color: var(--orange);
    animation: rpt-spin 0.7s linear infinite;
  }
  @keyframes rpt-spin { to { transform: rotate(360deg); } }
  .view :global(.rpt) {
    max-width: 1160px;
    margin: 0 auto;
    padding: 48px clamp(20px, 5vw, 48px) 0;
  }
  .view :global(.rpt-eyebrow),
  .state .rpt-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--orange);
  }
  .view :global(.rpt-eyebrow span) {
    color: #bbb;
    letter-spacing: 0;
    font-weight: 600;
  }
  .view :global(h1),
  .state h1 {
    margin: 14px 0 0;
    font-size: clamp(30px, 4.5vw, 48px);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 900px;
  }
  .view :global(h2) {
    margin: 12px 0 0;
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .view :global(h3) {
    margin: 0;
    font-size: clamp(22px, 2.8vw, 30px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .view :global(.rpt-lede),
  .state p {
    margin: 14px 0 0;
    font-size: 16px;
    color: var(--muted);
    line-height: 1.55;
    max-width: 640px;
    text-wrap: pretty;
  }
  .view :global(.rpt-sec .rpt-lede) { font-size: 15px; margin-top: 10px; }
  .state { padding: 48px clamp(20px, 5vw, 48px) 80px; max-width: 1160px; margin: 0 auto; }
  .state .rpt-btn { display: inline-flex; margin-top: 20px; }

  .view :global(.rpt-search) {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    border: 1px solid #dfe1e5;
    border-radius: 99px;
    padding: 10px 18px 10px 16px;
    box-shadow: 0 1px 6px rgba(32, 33, 36, 0.16);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    color: #202124;
  }
  .view :global(.rpt-search.is-in) { margin-top: 0; width: 100%; box-sizing: border-box; }
  .view :global(.rpt-search-icon) {
    width: 16px;
    height: 16px;
    border: 2px solid #9aa0a6;
