    align-items: center; justify-content: center; font-size: 22px; font-weight: 800; letter-spacing: -0.03em;
  }
  .view :global(.rpt-ring-lead) { font-size: 13px; font-weight: 700; margin-top: 3px; }
  .view :global(.rpt-pillar-grid) { flex: 1 1 240px; min-width: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; }
