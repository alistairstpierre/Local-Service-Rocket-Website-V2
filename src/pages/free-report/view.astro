  .view :global(.rpt-you) {
    margin-top: 14px;
    border: 1.5px dashed var(--orange);
    border-radius: 16px;
    background: #fff7f1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 24px;
    padding: 16px 18px;
  }
  .view :global(.rpt-you-badge) {
    position: absolute; left: 10px; top: 10px; padding: 4px 9px; border-radius: 99px;
    background: var(--orange); color: #fff; font-size: 10px; font-weight: 800; letter-spacing: 0.08em;
  }
  .view :global(.rpt-you-copy) { flex: 1 1 220px; min-width: 0; }
  .view :global(.rpt-you-pack) { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; margin-top: 12px; line-height: 1.1; }
  .view :global(.rpt-you-pack.is-sm) { font-size: 13px; margin-top: 0; }
  .view :global(.rpt-you-sub) { font-size: 12.5px; color: #6b6b6b; margin-top: 4px; line-height: 1.4; }
  .view :global(.rpt-jump) { display: inline-block; margin-top: 10px; font-size: 13px; font-weight: 800; color: var(--orange); }
  .view :global(.rpt-ring-wrap) { display: flex; align-items: center; gap: 12px; flex: none; }
  .view :global(.rpt-ring) {
    width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex: none;
  }
  .view :global(.rpt-ring div) {
