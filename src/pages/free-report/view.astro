  .view :global(.rpt-bars i.is-ink) { background: #1a1a1a; }
  .view :global(.rpt-legend) {
    grid-column: 1 / -1; display: flex; gap: 14px; font-size: 10.5px; color: #8a8a8a; font-weight: 600;
  }
  .view :global(.rpt-legend span),
  .view :global(.rpt-legend.is-map span) { display: flex; align-items: center; gap: 5px; }
  .view :global(.rpt-legend i.is-you),
  .view :global(.rpt-legend i.is-them) { width: 12px; height: 5px; border-radius: 99px; background: var(--orange); }
