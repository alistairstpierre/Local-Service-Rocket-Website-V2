    display: flex; justify-content: space-between; gap: 6px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em; color: #8a8a8a;
  }
  .view :global(.rpt-pillar-top span:first-child) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .view :global(.rpt-pillar-top b) { color: #1a1a1a; font-size: 13px; }
  .view :global(.rpt-bars) { margin-top: 5px; display: flex; flex-direction: column; gap: 3px; }
  .view :global(.rpt-bars div) { height: 5px; border-radius: 99px; background: #f3d9c6; }
