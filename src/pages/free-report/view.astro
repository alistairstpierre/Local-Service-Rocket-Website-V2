  .view :global(.rpt-legend.is-map) { margin-top: 12px; gap: 16px; font-size: 11.5px; flex-wrap: wrap; }
  .view :global(.rpt-legend .dot) { width: 12px; height: 12px; border-radius: 50%; }
  .view :global(.rpt-legend .dot.is-green) { background: #1b8a4b; }
  .view :global(.rpt-legend .dot.is-yellow) { background: #f0b429; }
  .view :global(.rpt-legend .dot.is-red) { background: #d1402f; }
  .view :global(.rpt-legend .dot.is-grey) { background: #cfd6dc; }
  .view :global(.rpt-legend .dot.is-ring) { border: 3px solid #1a1a1a; box-sizing: border-box; background: transparent; }
  .view :global(.rpt-map-credit) { margin-left: auto; font-weight: 500; color: #9a9a9a; }

  .view :global(.rpt-sec) { margin-top: 84px; }
  .view :global(.rpt-sec.is-tight) { margin-top: 56px; }
  .view :global(.rpt-sec-label) { display: flex; align-items: center; gap: 12px; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; color: var(--orange); }
  .view :global(.rpt-sec-label span:last-child) { font-weight: 700; letter-spacing: 0.1em; }
