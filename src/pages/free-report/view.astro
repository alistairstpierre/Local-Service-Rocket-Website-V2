    background: #fff7f1;
  }
  .view :global(.rpt-shop-photo) { position: relative; height: 150px; background: #f1f3f4; }
  .view :global(.rpt-shop-photo .rpt-photo) { height: 150px; width: 100%; }
  .view :global(.rpt-shop-badge) {
    position: absolute; left: 12px; top: 12px; padding: 5px 10px; border-radius: 99px;
    background: var(--orange); color: #fff; font-size: 10.5px; font-weight: 800; letter-spacing: 0.08em;
