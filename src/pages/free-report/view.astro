  .view :global(.rpt-shop-body) { padding: 16px 18px 18px; display: flex; flex-direction: column; flex: 1; }
  .view :global(.rpt-shop-top) { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .view :global(.rpt-shop-copy) { min-width: 0; }
  .view :global(.rpt-shop-pack) { font-size: 12px; font-weight: 800; margin-top: 8px; }
  .view :global(.rpt-shop-place) { text-align: right; flex: none; }
  .view :global(.rpt-shop-place-l) { font-size: 10px; font-weight: 800; letter-spacing: 0.08em; white-space: nowrap; }
  .view :global(.rpt-shop-score) { font-size: 32px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; margin-top: 3px; }
