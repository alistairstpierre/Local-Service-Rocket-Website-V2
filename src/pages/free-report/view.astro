---
/* Free-report viewer. Static shell that polls GET /api/reports/:id on Railway
   and renders the PublicReport through src/lib/free-report-render.ts.
   Layout matches Claude Design Files/Free Google Report.dc.html. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, breadcrumbList, graph, webPageNode } from '../../data/schema';

const title = 'Your free Google report | Local Service Rocket';
const description = 'Your Google profile, website, ads, and AI search rankings compared with the Map Pack.';
const pageUrl = absoluteUrl('/free-report/view/');
const jsonLd = graph([
  webPageNode({ pageUrl, name: title, description }),
  breadcrumbList(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Free Google report', path: '/free-report' },
    { name: 'Report', path: '/free-report/view' },
  ]),
]);

const apiUrl = (
  import.meta.env.DEV ? 'http://localhost:4322' : import.meta.env.PUBLIC_ANALYSIS_API_URL || ''
).replace(/\/$/, '');
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="view" data-api-url={apiUrl}>
    <div id="load-dock" class="rpt-dock" hidden>
      <div class="rpt-dock-bar"><i id="load-bar"></i></div>
      <div class="rpt-dock-row">
        <span id="load-now">Starting your report…</span>
        <span id="load-pct">0%</span>
      </div>
      <ol id="load-steps" class="rpt-dock-steps">
        <li data-step="profile">Profile</li>
        <li data-step="pack">Map Pack</li>
        <li data-step="website">Website</li>
        <li data-step="ads">Ads</li>
        <li data-step="ai">AI search</li>
      </ol>
    </div>
    <div id="state-error" class="state rpt" hidden>
      <div class="rpt-eyebrow">COULD NOT FINISH</div>
      <h1>We hit a snag.</h1>
      <p id="error-text"></p>
      <a class="rpt-btn" href="/free-report">Try again</a>
    </div>
    <div id="state-report"></div>
  </main>
</BaseLayout>

<script>
  import {
    examplePublicReport,
    loadingPublicReport,
    renderReportHtml,
    type PublicReport,
  } from '../../lib/free-report-render';

  const STAGES = ['profile', 'pack', 'website', 'ads', 'ai'] as const;
  const root = document.querySelector<HTMLElement>('.view');
  const apiUrl = root?.dataset.apiUrl || '';
  const id = new URLSearchParams(window.location.search).get('id');
  const dock = document.getElementById('load-dock');
  const errorBox = document.getElementById('state-error');
  const errorText = document.getElementById('error-text');
  const reportBox = document.getElementById('state-report');
  const loadNow = document.getElementById('load-now');
  const loadPct = document.getElementById('load-pct');
  const loadBar = document.getElementById('load-bar');
  let lastHtml = '';

  function showError(message: string) {
    if (dock) dock.hidden = true;
    if (errorBox) errorBox.hidden = false;
    if (reportBox) reportBox.hidden = true;
    if (errorText) errorText.textContent = message;
  }

  function readyCount(report?: PublicReport): number {
    const ready = report?.ready;
    if (!ready) return report ? STAGES.length : 0;
    return STAGES.filter((key) => {
      if (key === 'profile') return ready.hero;
      return Boolean(ready[key as 'pack' | 'website' | 'ads' | 'ai']);
    }).length;
  }

  function updateDock(progress: string, report?: PublicReport, done = false) {
    if (!dock) return;
    if (done) {
      dock.hidden = true;
      return;
    }
    dock.hidden = false;
    const n = readyCount(report);
    const pct = Math.max(6, Math.round((n / STAGES.length) * 100));
    if (loadBar) loadBar.style.width = `${pct}%`;
    if (loadPct) loadPct.textContent = `${pct}%`;
    if (loadNow) loadNow.textContent = progress || 'Working…';
    const current = report?.stage && report.stage !== 'complete' && report.stage !== 'queued' ? report.stage : STAGES[n] || 'profile';
    dock.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => {
      const step = el.dataset.step || '';
      const doneStep =
        step === 'profile' ? Boolean(report?.ready?.hero) : Boolean(report?.ready?.[step as 'pack' | 'website' | 'ads' | 'ai']);
      el.classList.toggle('is-done', doneStep);
      el.classList.toggle('is-now', !doneStep && step === current);
    });
  }

  function render(report: PublicReport) {
    if (!reportBox) return;
    reportBox.hidden = false;
    document.title = `${report.subjectName} Google report | Local Service Rocket`;
    const html = renderReportHtml(report);
    if (html === lastHtml) return;
    lastHtml = html;
    reportBox.innerHTML = html;
  }

  if (!id) {
    render(examplePublicReport());
  } else if (!apiUrl) {
    showError('The report API is not configured.');
  } else {
    render(loadingPublicReport('Your shop', ''));
    updateDock('Finding your Google Business Profile');
    void poll(id);
  }

  async function poll(reportId: string) {
    for (let i = 0; i < 200; i++) {
      try {
        const res = await fetch(`${apiUrl}/api/reports/${encodeURIComponent(reportId)}`);
        const data = await res.json();
        if (res.status === 404) return showError('That report was not found.');
        if (data.status === 'failed') return showError(data.error || 'The report failed.');
        const report =
          (data.report as PublicReport | undefined) ||
          loadingPublicReport(data.lead?.businessName || 'Your shop', data.lead?.city || '');
        render(report);
        updateDock(data.progress || 'Working…', data.report, data.status === 'complete');
        if (data.status === 'complete' && data.report) return;
      } catch {
        updateDock('Still connecting to the report service…');
      }
      await new Promise((r) => setTimeout(r, 1500));
    }
    showError('The report is taking too long. Refresh this page in a minute.');
  }
</script>

<style>
  .rpt-dock {
    position: sticky;
    top: 72px;
    z-index: 30;
    background: #fff;
    border-bottom: 1px solid #ececec;
    padding: 12px clamp(20px, 5vw, 48px) 14px;
