  .view :global(.rpt-pack) {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
    align-items: flex-start;
  }
  .view :global(.rpt-serp) {
    flex: 1 1 300px;
    border: 1px solid #dadce0;
    border-radius: 18px;
    overflow: hidden;
    font-family: Arial, Helvetica, sans-serif;
    background: #fff;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .view :global(.rpt-serp-head) { padding: 14px 16px 10px; font-family: Manrope, sans-serif; }
