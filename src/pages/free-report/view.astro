---
/* Free-report viewer. Static shell that polls GET /api/reports/:id on Railway
   and renders the PublicReport JSON (scores, competitors, gaps). Linked from
   the form at /free-report and from the Resend email. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, breadcrumbList, graph, webPageNode } from '../../data/schema';

const title = 'Your free Google report | Local Service Rocket';
const description = 'Your Google profile, website, ads, and AI search rankings compared with the Map Pack.';
const pageUrl = absoluteUrl('/free-report/view/');
const jsonLd = graph([
  webPageNode({ pageUrl, name: title, description }),
  breadcrumbList(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Free Google report', path: '/free-report' },
    { name: 'Report', path: '/free-report/view' },
  ]),
]);

const apiUrl = (import.meta.env.PUBLIC_ANALYSIS_API_URL || '').replace(/\/$/, '');
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="view container" data-api-url={apiUrl}>
    <p class="crumbs"><a href="/free-report">Free Google report</a> / Your report</p>
    <div id="state-loading" class="state">
      <div class="eyebrow">BUILDING YOUR REPORT</div>
      <h1>Pulling Google, your site, ads, and AI search in your market.</h1>
      <p id="progress">Starting…</p>
    </div>
    <div id="state-error" class="state" hidden>
      <div class="eyebrow">COULD NOT FINISH</div>
      <h1>We hit a snag.</h1>
      <p id="error-text"></p>
      <a class="btn btn-primary" href="/free-report">Try again</a>
    </div>
    <div id="state-report" hidden></div>
  </main>
</BaseLayout>

<script>
  type ReportBusiness = {
    name: string;
    isSubject: boolean;
    packPosition?: number;
    scores: { gbp: number; website: number; ads: number; ai: number; overall: number };
    gbp: {
      rating?: number;
      reviewCount: number;
      reviewsLastMonth?: number;
      hasDescription: boolean;
      hasWebsite: boolean;
      hasPhone: boolean;
    };
    website?: { rootUrl: string; performanceScore?: number; referringDomains?: number };
    ads?: { inLsa: boolean; lsaPosition?: number; runningSearchAds: boolean };
    ai?: {
      mentioned: boolean;
      chatGptMentioned?: boolean;
      geminiMentioned?: boolean;
      chatGptPosition?: number;
      geminiPosition?: number;
      cited?: boolean;
    };
  };

  type PublicReport = {
    subjectName: string;
    city: string;
    keyword: string;
    overallScore: number;
    pillars: { gbp: number; website: number; ads: number; ai?: number };
    businesses: ReportBusiness[];
    gaps: string[];
    cta: { href: string; label: string };
  };

  const root = document.querySelector<HTMLElement>('.view');
  const apiUrl = root?.dataset.apiUrl || '';
  const id = new URLSearchParams(window.location.search).get('id');
  const loading = document.getElementById('state-loading');
  const errorBox = document.getElementById('state-error');
  const errorText = document.getElementById('error-text');
  const progress = document.getElementById('progress');
  const reportBox = document.getElementById('state-report');

  function showError(message: string) {
    if (loading) loading.hidden = true;
    if (errorBox) errorBox.hidden = false;
    if (errorText) errorText.textContent = message;
  }

  if (!id || !apiUrl) {
    showError(!id ? 'Missing report id.' : 'The report API is not configured.');
  } else {
    void poll(id);
  }

  async function poll(reportId: string) {
    for (let i = 0; i < 150; i++) {
      const res = await fetch(`${apiUrl}/api/reports/${encodeURIComponent(reportId)}`);
      const data = await res.json();
      if (res.status === 404) return showError('That report was not found.');
      if (progress) progress.textContent = data.progress || 'Working…';
      if (data.status === 'failed') return showError(data.error || 'The report failed.');
      if (data.status === 'complete' && data.report) return render(data.report as PublicReport);
      await new Promise((r) => setTimeout(r, 2000));
    }
    showError('The report is taking too long. Refresh this page in a minute.');
  }

  function render(report: PublicReport) {
    if (loading) loading.hidden = true;
    if (!reportBox) return;
    reportBox.hidden = false;
    document.title = `${report.subjectName} Google report | Local Service Rocket`;
    reportBox.innerHTML = `
      <div class="eyebrow">YOUR FREE REPORT</div>
      <h1>${escapeHtml(report.subjectName)} vs the Map Pack in ${escapeHtml(report.city)}</h1>
      <p class="lede">Keyword: <strong>${escapeHtml(report.keyword)}</strong></p>
      <div class="scores">
        ${scoreCard('Overall', report.overallScore)}
        ${scoreCard('Google profile', report.pillars.gbp)}
        ${scoreCard('Website', report.pillars.website)}
        ${scoreCard('Ads', report.pillars.ads)}
        ${scoreCard('AI search', report.pillars.ai ?? 0)}
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Business</th>
              <th>Pack</th>
              <th>GBP</th>
              <th>Website</th>
              <th>Ads</th>
              <th>AI</th>
              <th>Reviews</th>
              <th>LSA</th>
              <th>Search ads</th>
              <th>ChatGPT</th>
              <th>Gemini</th>
            </tr>
          </thead>
          <tbody>
            ${report.businesses
              .map(
                (b) => `<tr class="${b.isSubject ? 'you' : ''}">
                  <td>${escapeHtml(b.name)}${b.isSubject ? ' <em>you</em>' : ''}</td>
                  <td>${b.packPosition ?? '—'}</td>
                  <td>${b.scores.gbp}</td>
                  <td>${b.scores.website}</td>
                  <td>${b.scores.ads}</td>
                  <td>${b.scores.ai ?? '—'}</td>
                  <td>${b.gbp.reviewCount}${b.gbp.rating ? ` · ${b.gbp.rating}` : ''}</td>
                  <td>${b.ads?.inLsa ? `Yes${b.ads.lsaPosition ? ` (#${b.ads.lsaPosition})` : ''}` : 'No'}</td>
                  <td>${b.ads?.runningSearchAds ? 'Yes' : 'No'}</td>
                  <td>${aiCell(b.ai?.chatGptPosition, b.ai?.chatGptMentioned)}</td>
                  <td>${aiCell(b.ai?.geminiPosition, b.ai?.geminiMentioned)}</td>
                </tr>`
              )
              .join('')}
          </tbody>
        </table>
      </div>
      <section class="gaps">
        <h2>Where you are losing</h2>
        <ul>${report.gaps.map((g) => `<li>${escapeHtml(g)}</li>`).join('')}</ul>
      </section>
      <section class="cta">
        <h2>Want us to close the gaps?</h2>
        <p>Watch how it works, see the price, then book onboarding.</p>
        <a class="btn btn-primary btn-lg" href="${escapeHtml(report.cta.href)}">${escapeHtml(report.cta.label)}</a>
      </section>
    `;
  }

  function scoreCard(label: string, value: number) {
    return `<article class="score"><span>${escapeHtml(label)}</span><strong>${value}</strong></article>`;
  }

  function aiCell(position: number | undefined, mentioned?: boolean) {
    if (typeof position === 'number') return `#${position}`;
    if (mentioned) return 'Named';
    return '—';
  }

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }
</script>

<style>
  .view { padding: 48px 0 80px; }
  .crumbs { font-size: 13px; color: var(--muted-3); }
  .eyebrow { margin-top: 22px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; color: var(--orange); }
  h1 { margin-top: 12px; font-size: clamp(28px, 4vw, 42px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; max-width: 20ch; }
  .lede, .state p { margin-top: 16px; color: var(--body); line-height: 1.6; }
  .scores { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin: 28px 0; }
  .score { border: 1px solid var(--border); border-radius: var(--radius-card); padding: 16px; background: var(--section-bg); }
  .score span { display: block; font-size: 12px; font-weight: 700; color: var(--muted); }
  .score strong { display: block; margin-top: 6px; font-size: 32px; letter-spacing: -0.03em; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-card); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--hairline); white-space: nowrap; }
  th { font-size: 12px; color: var(--muted); }
  tr.you { background: var(--orange-tint); font-weight: 700; }
  em { font-style: normal; color: var(--orange); font-size: 12px; }
  .gaps, .cta { margin-top: 36px; }
  .gaps ul { margin: 14px 0 0; padding-left: 1.15em; color: var(--body); line-height: 1.65; }
  .gaps li + li { margin-top: 8px; }
  .cta { padding: 28px; border-radius: var(--radius-panel); background: var(--dark); color: var(--dark-text); }
  .cta h2 { color: #fff; }
  .cta p { color: var(--dark-muted); margin: 10px 0 18px; }
  @media (max-width: 800px) { .scores { grid-template-columns: 1fr 1fr; } }
</style>
