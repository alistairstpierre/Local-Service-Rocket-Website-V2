---
/* Get Started funnel page and primary conversion path from every CTA on the site.
   Structure mirrors the VSL beat for beat (content/VSL-SCRIPT.md is the source of
   truth for the wording): click-to-play video -> big booking CTA -> 3 steps ->
   fit / anti-fit -> what to expect -> pricing -> objections -> exits for people
   who aren't ready. Keep this page and the video saying the same thing.
   Design origin: Get Started.dc.html */
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingOffer from '../components/PricingOffer.astro';
import {
  absoluteUrl,
  breadcrumbList,
  faqPageNode,
  graph,
  webPageNode,
} from '../data/schema';

const BOOKING = 'https://api.leadconnectorhq.com/widget/booking/Tp6doLoKjJfMEvnKPOn1';

const title = 'Schedule Onboarding With No Sales Calls | Local Service Rocket';
const description =
  'See exactly how Local Service Rocket works for home service companies, then book your onboarding call online. No sales calls. Starts around $500/month.';
const pageUrl = absoluteUrl('/get-started/');

const faqs = [
  {
    q: 'I’ve hired agencies before and got burned. Why trust you?',
    a: 'Look up the companies we name, they’re active and doing well today. Multiple home-service examples beat a single hero case study. Scalable fees mean we’re incentivized to get you to Orbit, not extract a giant setup and disappear.',
  },
  {
    q: 'I don’t want to start today.',
    a: 'Foundations take time; meaningful movement is often on a ~two-month clock. If you’re not ready for a serious multi-year partnership, we’re not the right fit.',
  },
  {
    q: 'I’ll only pay on results.',
    a: 'This is a partnership: we already price below typical big-agency day-one fees because we trust you’ll sell and run the company. Pure pay-on-results without CRM access / equity isn’t how we work. LSA is already pay-per-booked-call on that lane.',
  },
  {
    q: 'We tried Google / Facebook and it doesn’t work.',
    a: 'It’s a skill game. Wrong category, weak site, or lazy accounts kill results, not “Google is dead.” For search-intent trades, Google is still the spine.',
  },
  {
    q: 'Do I get Alistair, or someone else?',
    a: 'You get one expert who owns your account start to finish, either Alistair or one of our specialists depending on what your company needs. We call it the surgeon model: the person who diagnoses you is the person who does the work. No account manager, no handoff, no junior learning on your budget.',
  },
  {
    q: 'What do you do differently?',
    a: 'One expert accountable for the result rather than a task list, fees that scale with you, Google as a system (profile + site + ads), and booked jobs over lead theater.',
  },
  {
    q: 'Am I locked into a contract?',
    a: 'No. Every engagement is month to month and we have never locked a client into a term. Fees start low and only step up as results do. People stay for years because it is working, not because they signed something.',
  },
];

const jsonLd = graph([
  webPageNode({ pageUrl, name: title, description }),
  faqPageNode(pageUrl, faqs),
  breadcrumbList(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Get Started', path: '/get-started' },
  ]),
]);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main>
    <div class="intro container">
      <div class="badge">OWN GOOGLE IN YOUR SERVICE AREA</div>
      <h1>See Exactly How It Works, Then Book Onboarding</h1>
      <p class="intro-lede">
        Built for electricians and other home service owners who want Google booking jobs without a
        $5,000 pitch. Watch how it works, see the price, book yourself in.
      </p>
    </div>

    <div class="video-wrap container">
      <div class="vsl" id="vsl">
        <button
          type="button"
          class="vsl-facade"
          aria-label="Play the walkthrough video, 6 minutes 15 seconds"
          data-loom-id="ee9863bff0864f5fa22d4073e1230beb"
        >
          <span class="vsl-play" aria-hidden="true">▶</span>
          <span class="vsl-label">Watch the walkthrough</span>
          <span class="vsl-meta">6:15 · the whole pitch, then you decide</span>
        </button>
      </div>
    </div>

    <div class="vsl-cta container">
      <a href={BOOKING} class="btn btn-primary">Schedule my onboarding call</a>
      <p class="vsl-cta-note">
        <strong>This is not a sales call.</strong> If you book it, come ready to start and we’ll come
        ready to diagnose. Watched it and you’re not there yet? That’s fine.
        <a href="#not-ready">Here’s what to do instead</a>.
      </p>
    </div>

    <div class="steps container">
      <div class="step">
        <div class="num">1</div>
        <div class="title">Watch the six minutes</div>
        <p>
          How the work is done, what it costs, and what we need from you. The whole thing, with no
          call needed to find out.
        </p>
      </div>
      <div class="step">
        <div class="num">2</div>
        <div class="title">Book your onboarding call</div>
        <p>
          We look at your Google setup and tell you the one thing holding your phone back. It is a
          diagnosis, not a pitch.
        </p>
      </div>
      <div class="step">
        <div class="num">3</div>
        <div class="title">Start by fixing that one thing</div>
        <p>
          No $12,000 package on day one. We fix the biggest problem first, and the fee only goes up
          once the work is paying for itself.
        </p>
      </div>
    </div>

    <div class="fit container">
      <div class="fit-head">
        <div class="eyebrow">BEFORE YOU BOOK</div>
        <h2>We work with one type of person.</h2>
      </div>
      <div class="fit-grid">
        <div class="fit-card fit-yes">
          <div class="fit-title">Book if this is you</div>
          <ul>
            <li>
              You own a home service company — electrical, plumbing, HVAC, waterproofing, roofing
            </li>
            <li>Your customers go to Google when they need what you sell</li>
            <li>You looked at our clients and thought <em>that’s what I want for my shop</em></li>
            <li>You’re willing to put your own time and effort in to get there</li>
          </ul>
        </div>
        <div class="fit-card fit-no">
          <div class="fit-title">Don’t book if this is you</div>
          <ul>
            <li>You want guaranteed outcomes — nobody honest gives you those</li>
            <li>You want to pay only on results</li>
            <li>You’ve already decided Google doesn’t work</li>
            <li>You need it to pay off next week</li>
          </ul>
        </div>
      </div>
      <p class="fit-note">
        If the second list is you, close the tab — and we mean that kindly. The worst outcome for
        both of us is a client who got talked into it.
      </p>
    </div>

    <div class="expect container">
      <div class="eyebrow">WHAT TO EXPECT</div>
      <h2>What working with us is actually like.</h2>
      <ul>
        <li>
          <strong>One person, not a team.</strong> Alistair or one of our specialists runs your
          account from the first look through all the work, and is answerable for the result. No
          account manager, no handing you off to a junior.
        </li>
        <li>
          <strong>We handle Google, you handle the work.</strong> We bring the calls in. You sell
          the job, do it well, and ask for the review.
        </li>
        <li>
          <strong>You should feel it in about two months.</strong> We watch booked jobs and call
          volume. If nothing is moving by then, we tell you straight.
        </li>
        <li>
          <strong>No guarantees.</strong> Nobody honest can promise Google results. What you get is
          a clear plan, honest timelines, small budgets early, and problems fixed fast.
        </li>
        <li>
          <strong>The fee grows with you.</strong> You start at $500 a month. We earn more once you
          are running real ad spend and making real money, so we both want the same thing.
        </li>
      </ul>
    </div>

    <PricingOffer
      eyebrow="THE NUMBERS"
      h2="Skip the Pitch. Prices Start at $500/mo"
      lede={`Fees follow the <a href="/flight-plan">Flight Plan</a> and only step up once your results do. Month to month. We have never locked a client into a contract.`}
      ctaHref={BOOKING}
      ctaLabel="Schedule my onboarding call"
      footNote="Everything explained in the video above"
    />

    <div class="faq container">
      <div class="measure">
        <div class="measure__spine" aria-hidden="true"></div>
        <div class="measure__copy">
          <div class="eyebrow">COMMON OBJECTIONS</div>
          <h2>Straight Answers Before You Book</h2>
          <div class="faq-list">
            <div class="faq-item">
              <div class="q">I’ve hired agencies before and got burned. Why trust you?</div>
              <p>
                Go and look up the companies we name. They are all trading today and you can see where they
                sit in Google. Several real examples beat one polished story. And because our fee only grows
                when you do, we make our money by getting you bigger, not by taking a big setup fee and
                going quiet.
              </p>
            </div>
            <div class="faq-item">
              <div class="q">I don’t want to start today.</div>
              <p>
                Fair enough. The groundwork takes time and you usually do not see real movement for about
                two months, so this only works if you are in it for the long run. If you have watched the
                video and you are still unsure, wait until you are sure.
              </p>
            </div>
            <div class="faq-item">
              <div class="q">I’ll only pay on results.</div>
              <p>
                We already charge far less on day one than a big agency does, because we are trusting you to
                sell the work and run the company well. Paying purely on results would mean us in your books
                or in your business, and that is not how we work. Local Services Ads are the exception:
                Google already charges you per lead there.
              </p>
            </div>
            <div class="faq-item">
              <div class="q">We tried Google or Facebook and it “doesn’t work.”</div>
              <p>
                Usually something specific was broken: the wrong category on the Google profile, a slow
                website, or an ad account nobody touched. When a homeowner’s power is out they search
                Google, so that is still where the money is. If you are not willing to fix Google, we are
                not the right fit.
              </p>
            </div>
            <div class="faq-item">
              <div class="q">Do I get Alistair, or someone else?</div>
              <p>
                You get one person who owns your account start to finish, either Alistair or one of our
                specialists, depending on what your company needs. The person who looks at your setup is the
                person who does the work. No account manager, no handoff, no junior learning on your budget.
              </p>
            </div>
            <div class="faq-item">
              <div class="q">Am I locked into a contract?</div>
              <p>
                No. Everything is month to month and we have never tied a client into a term. The fee starts
                low and only steps up once results do. People stay for years because it is working, not
                because they signed something.
              </p>
            </div>
            <div class="faq-item">
              <div class="q">What do you do differently?</div>
              <p>
                One person answerable for the result, a fee that starts low and grows with you, and Google
                treated as one system: your profile, your website and your ads all pulling together. We
                measure booked jobs, not how many “leads” we can claim. See the
                <a href="/flight-plan">Flight Plan</a> and the <a href="/case-studies">case studies</a>.
              </p>
            </div>
          </div>
        </div>
        <div class="measure__rail" aria-hidden="true"></div>
      </div>
    </div>

    <div class="not-ready container" id="not-ready">
      <div class="nr-inner">
        <div class="eyebrow">NOT READY TO BOOK?</div>
        <h2>Three options, and all of them are fine.</h2>
        <div class="nr-grid">
          <div class="nr-item">
            <div class="nr-title">Ask a question</div>
            <p>
              Email <a href="mailto:hello@localservicerocket.com">hello@localservicerocket.com</a> and
              you’ll get a straight answer, not a pitch.
            </p>
          </div>
          <div class="nr-item">
            <div class="nr-title">Read the numbers</div>
            <p>
              The full stories behind the companies in the video are on the
              <a href="/case-studies">case studies</a>, and the staged plan is on the
              <a href="/flight-plan">Flight Plan</a>.
            </p>
          </div>
          <div class="nr-item">
            <div class="nr-title">Go and check us</div>
            <p>
              Search our clients in Google yourself. Every company we name is real, trading, and
              sitting at the top of its market.
            </p>
          </div>
        </div>
        <p class="nr-note">
          What won’t happen: chasing, a follow-up sequence, or a rep working your objections. Come
          back when you’re ready.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // Click-to-play so the Loom iframe (and its third-party requests) only loads if
  // someone actually wants the video. Inline styles on the iframe: Astro's scoped
  // CSS can't reach an element created at runtime.
  const player = document.getElementById('vsl');
  const facade = player?.querySelector<HTMLButtonElement>('.vsl-facade');

  facade?.addEventListener('click', () => {
    const id = facade.dataset.loomId;
    if (!id || !player) return;

    facade.classList.add('is-loading');
    facade.setAttribute('aria-busy', 'true');

    const params = 'autoplay=1&hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true';
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.loom.com/embed/${id}?${params}`;
    iframe.title = 'How Local Service Rocket works';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.setAttribute(
      'style',
      'position:absolute;inset:0;width:100%;height:100%;border:0;display:block;'
    );

    iframe.addEventListener('load', () => facade.remove(), { once: true });
    player.appendChild(iframe);
  });
</script>

