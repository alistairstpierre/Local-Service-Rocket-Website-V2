---
/* Blog index, articles adapted from brain dumps for the LSR marketing site. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, breadcrumbList, graph } from '../../data/schema';

const posts = [
  {
    href: '/blog/bad-vs-good-agency',
    title: 'What a bad home-service agency looks like (vs a good one)',
    dek: 'Lead fluff, fake guarantees, and locked-in rebuilds vs partners who optimize for booked jobs.',
    date: 'September 2026',
  },
  {
    href: '/blog/realistic-marketing-expectations',
    title: 'Realistic expectations for home-service marketing',
    dek: 'Timelines, plateaus, and why Google is a system, not a slot machine.',
    date: 'September 2026',
  },
  {
    href: '/blog/good-google-marketing',
    title: 'What good Google marketing looks like for trades',
    dek: 'GBP + site + LSA + Search: what winning looks like in booked work, not vanity metrics.',
    date: 'September 2026',
  },
  {
    href: '/blog/ai-websites-arent-slop',
    title: 'AI websites aren’t automatically slop. Lazy briefs are.',
    dek: 'Google cares about fundamentals. Structure first, then AI for speed.',
    date: 'September 2026',
  },
  {
    href: '/blog/google-category-relevance',
    title: 'The Google Business Profile mistake that silently kills electrician leads',
    dek: 'How a single primary category change took a stuck electrical company to 1-3 organic calls a day.',
    date: 'May 2026',
  },
  {
    href: '/blog/dry-duck-launch',
    title: 'How Dry Duck went from a $500 brief to ranking Des Moines for basement waterproofing',
    dek: 'Brand, StoryBrand site structure, local SEO expansion, and why we build with AI-assisted development instead of slow page builders.',
    date: 'April 2026',
  },
];

const title = 'Home Service Marketing Notes and Lessons | Local Service Rocket';
const description =
  'Practical notes on local SEO, Google Business Profiles, converting websites, and growing home service companies on Google. Read before you hire.';
const pageUrl = absoluteUrl('/blog/');
const jsonLd = graph([
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': 'https://localservicerocket.com/#website' },
    mainEntity: { '@id': `${pageUrl}#list` },
  },
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#list`,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.title,
      url: absoluteUrl(post.href),
    })),
  },
  breadcrumbList(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ]),
]);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="blog">
    <div class="intro container">
      <div class="eyebrow">BLOG</div>
      <h1>Notes from the field.</h1>
      <p>
        Lessons from real home service marketing, Google profiles, websites, ads, and the systems
        behind companies that actually grow.
      </p>
    </div>
    <div class="list container">
      {
        posts.map((p) => (
          <a href={p.href} class="card">
            <div class="date">{p.date}</div>
            <div class="title">{p.title}</div>
            <p>{p.dek}</p>
            <div class="more">Read article →</div>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .blog {
    padding: 64px 0 72px;
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .intro p {
    margin-top: 14px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 52ch;
  }

  .list {
    margin-top: 40px;
    display: grid;
    gap: 16px;
  }

  .card {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    padding: 28px;
    color: var(--ink);
    transition: border-color 0.2s;
  }

  .card:hover {
    border-color: var(--orange);
    color: var(--ink);
  }

  .date {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--orange);
  }

  .title {
    margin-top: 10px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .card p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .more {
    margin-top: 16px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--orange);
  }
</style>
