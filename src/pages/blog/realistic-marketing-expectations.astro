        <td>6 months</td>
      </tr>
      <tr>
        <td><a href="/case-studies/honest-hanks">Honest Hank’s</a></td>
        <td>$25k months, 1 tech</td>
        <td>$80k months, 3 techs</td>
        <td>~8 months</td>
      </tr>
