---
/* Contact page: message Local Service Rocket via EmailJS.
   Owners can ask a question, request a free audit, or book a coaching session,
   with optional brand/website screenshots. SDK loads only on submit. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl, breadcrumbList, graph, webPageNode } from '../data/schema';

const title = 'Contact Local Service Rocket | Questions, Audit, or Coaching';
const description =
  'Message Local Service Rocket with a question, or ask for a free marketing audit or coaching session. Attach website or brand screenshots if you have them.';
const pageUrl = absoluteUrl('/contact/');
const jsonLd = graph([
  webPageNode({ pageUrl, name: title, description }),
  {
    '@type': 'ContactPage',
    '@id': `${pageUrl}#contact`,
    url: pageUrl,
    name: title,
    description,
    mainEntity: { '@id': 'https://localservicerocket.com/#business' },
  },
  breadcrumbList(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]),
]);

const emailjs = {
  // EmailJS browser public credentials (safe to expose; restrict domain in dashboard).
  // Env vars override these when set (local .env / Vercel).
  publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY || 'goZgtci4tbrXpsrDj',
  serviceId: import.meta.env.PUBLIC_EMAILJS_SERVICE_ID || 'service_ta1cze3',
  templateId: import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID || 'template_qy8i9xk',
};
const emailjsReady = Boolean(emailjs.publicKey && emailjs.serviceId && emailjs.templateId);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="contact">
    <section class="hero container">
      <div class="crumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span class="current">Contact</span>
      </div>
      <div class="eyebrow">CONTACT</div>
      <h1>Ask us anything. It costs nothing to find out.</h1>
      <p class="lede">
        You know something is off. The phone should ring more than it does, the ads feel expensive,
        or the last agency left you guessing. Tell us what is going on and we will tell you what we
        would do about it. Straight answer, in writing, from the person who would actually do the
        work. No sales call. No pressure.
      </p>
    </section>

    <section class="container panel">
      <div class="copy">
        <div class="eyebrow">PICK WHAT FITS</div>
        <h2>Three ways we can help this week.</h2>
        <ul class="bullets">
          <li>
            <strong>Ask a question.</strong> Local Services Ads, Google profile, hiring, websites,
            what things cost. If you have wondered about it, someone else has asked us. You will get a
            real answer, not a brochure.
          </li>
          <li>
            <strong>Get a free audit.</strong> Send your website link and a few screenshots. We look
            at your Google profile, your site, and your ads, then reply with what is working, what is
            costing you calls, and the one fix we would make first. Free, and yours to keep whether
            you hire us or not.
          </li>
          <li>
            <strong>Book a coaching session.</strong> Stuck on one decision? LSA or Search, hire or
            hold, where the next dollar goes. We will work it through with you so you can move.
          </li>
        </ul>
        <div class="aside">
          <div class="aside-label">WHY OWNERS WRITE TO US</div>
          <p>
            Six home service companies scaled. Over $10M in new revenue. Five stars on Google. Every
            reply comes from Alistair, who runs the accounts himself. Read the
            <a href="/case-studies">client results</a>, then send us yours.
          </p>
        </div>
        <p class="alt-contact">
          Prefer email? <a href="mailto:hello@localservicerocket.com">hello@localservicerocket.com</a>.
          Already decided? <a href="/get-started">Schedule onboarding</a>.
        </p>
      </div>

      <div class="form-wrap">
        {
          !emailjsReady && (
            <p class="config-warn" role="status">
              The form is not wired up yet. Email
              <a href="mailto:hello@localservicerocket.com">hello@localservicerocket.com</a> and
              attach your screenshots, or set the EmailJS keys (see README).
            </p>
          )
        }
        <form
          id="contact-form"
          class="form"
          novalidate
          data-emailjs-ready={emailjsReady ? '1' : '0'}
          data-public-key={emailjs.publicKey}
          data-service-id={emailjs.serviceId}
          data-template-id={emailjs.templateId}
        >
          <div class="row two">
            <label>
              <span>Your name</span>
              <input
                type="text"
                name="from_name"
                autocomplete="name"
                required
                minlength="2"
                maxlength="120"
                aria-describedby="err-from_name"
              />
              <span class="field-error" id="err-from_name" role="alert" hidden></span>
            </label>
            <label>
              <span>Email</span>
              <input
                type="email"
                name="reply_to"
                autocomplete="email"
                required
                maxlength="160"
                aria-describedby="err-reply_to"
              />
              <span class="field-error" id="err-reply_to" role="alert" hidden></span>
            </label>
          </div>

          <div class="row two">
            <label>
              <span>Phone <em>(optional)</em></span>
              <input
                type="tel"
                name="phone"
                autocomplete="tel"
                maxlength="40"
                inputmode="tel"
                aria-describedby="err-phone"
              />
              <span class="field-error" id="err-phone" role="alert" hidden></span>
            </label>
            <label>
              <span>Company <em>(optional)</em></span>
              <input
                type="text"
                name="company"
                autocomplete="organization"
                maxlength="120"
                aria-describedby="err-company"
              />
              <span class="field-error" id="err-company" role="alert" hidden></span>
            </label>
          </div>

          <label class="row">
            <span>Website URL <em>(optional)</em></span>
            <input
              type="url"
              name="website"
              inputmode="url"
              placeholder="https://yoursite.com"
              maxlength="200"
              aria-describedby="err-website"
            />
            <span class="field-error" id="err-website" role="alert" hidden></span>
          </label>

          <label class="row">
            <span>What do you need?</span>
            <select name="reason" required aria-describedby="err-reason">
              <option value="" disabled selected>Choose one</option>
              <option value="Just a question">Just a question</option>
              <option value="Free marketing audit">Free marketing audit</option>
              <option value="Coaching session">Coaching session</option>
              <option value="Something else">Something else</option>
            </select>
            <span class="field-error" id="err-reason" role="alert" hidden></span>
          </label>

          <label class="row">
            <span>Your message</span>
            <textarea
              name="message"
              rows="5"
              required
              minlength="20"
              maxlength="4000"
              placeholder="Tell us about your shop and what you want to know. The more detail, the better the answer."
              aria-describedby="err-message"
            ></textarea>
            <span class="field-error" id="err-message" role="alert" hidden></span>
          </label>

          <div class="row file-block">
            <span class="file-label">Brand or website screenshots <em>(optional)</em></span>
            <p class="file-hint">
              Logo, van wrap, homepage, Google profile, or ads screenshots. Up to 4 files, images or
              PDFs. Combined size must stay under <strong>2&nbsp;MB</strong> (EmailJS Professional
              limit). Phone photos are often too big; export or compress first.
            </p>
            <!--
              EmailJS template: add Form File Attachments named screenshot_1 to screenshot_4
              (Professional plan). See README.
            -->
            <input
              id="screenshot_1"
              class="file-input"
              type="file"
              name="screenshot_1"
              accept="image/*,.pdf,application/pdf"
            />
            <input
              id="screenshot_2"
              class="file-input"
              type="file"
              name="screenshot_2"
              accept="image/*,.pdf,application/pdf"
            />
            <input
              id="screenshot_3"
              class="file-input"
              type="file"
              name="screenshot_3"
              accept="image/*,.pdf,application/pdf"
            />
            <input
              id="screenshot_4"
              class="file-input"
              type="file"
              name="screenshot_4"
              accept="image/*,.pdf,application/pdf"
            />
            <button type="button" class="file-btn" id="file-picker" data-next="1">
              Choose files
            </button>
            <ul class="file-list" id="file-list" hidden></ul>
            <span class="field-error" id="err-files" role="alert" hidden></span>
          </div>

          <p class="privacy">
            We reply to every message, usually within one business day. We never sell your info. See
            the <a href="/privacy">privacy policy</a>.
          </p>

          <button type="submit" class="btn btn-primary btn-lg submit" id="submit-btn" disabled>
            Send it through
          </button>
          <p class="status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  if (form instanceof HTMLFormElement) {
    const statusEl = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');
    const fileList = document.getElementById('file-list');
    const picker = document.getElementById('file-picker');
    const filesError = document.getElementById('err-files');
    // EmailJS Professional: attachments up to 2 MB (plan limit; 413 if the request is larger).
    const MAX_TOTAL_BYTES = 2 * 1024 * 1024;
    const ALLOWED_FILE =
      /^(image\/|application\/pdf$)/i;
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const slots = [1, 2, 3, 4].map((n) => document.getElementById(`screenshot_${n}`));
    /** @type {Set<string>} */
    const touched = new Set();
    let sending = false;

    function setStatus(text, kind) {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.dataset.kind = kind || '';
    }

    function attachedFiles() {
      return slots
        .filter((input) => input instanceof HTMLInputElement && input.files?.[0])
        .map((input) => /** @type {HTMLInputElement} */ (input).files[0]);
    }

    function totalBytes() {
      return attachedFiles().reduce((sum, file) => sum + file.size, 0);
    }

    function formatMb(bytes) {
      return (bytes / (1024 * 1024)).toFixed(2);
    }

    function setFieldError(field, message) {
      const name = field.getAttribute('name');
      const err = name ? document.getElementById(`err-${name}`) : null;
      if (message) {
        field.setAttribute('aria-invalid', 'true');
        field.classList.add('is-invalid');
        if (err) {
          err.textContent = message;
          err.hidden = false;
        }
      } else {
        field.removeAttribute('aria-invalid');
        field.classList.remove('is-invalid');
        if (err) {
          err.textContent = '';
          err.hidden = true;
        }
      }
    }

    function setFilesError(message) {
      if (!(filesError instanceof HTMLElement)) return;
      if (message) {
        filesError.textContent = message;
        filesError.hidden = false;
      } else {
        filesError.textContent = '';
        filesError.hidden = true;
      }
    }

    function normalizeWebsite(value) {
      const v = value.trim();
      if (!v) return '';
      if (/^https?:\/\//i.test(v)) return v;
      return `https://${v}`;
    }

    function isValidWebsite(value) {
      try {
        const url = new URL(normalizeWebsite(value));
        return url.protocol === 'http:' || url.protocol === 'https:';
      } catch {
        return false;
      }
    }

    function fieldErrorMessage(field) {
      if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) {
        return '';
      }
      const name = field.name;
      const value = field.value.trim();

      if (name === 'from_name') {
        if (!value) return 'Enter your name.';
        if (value.length < 2) return 'Name needs at least 2 characters.';
        return '';
      }
      if (name === 'reply_to') {
        if (!value) return 'Enter your email.';
        if (!EMAIL_RE.test(value)) return 'Enter a valid email address.';
        return '';
      }
      if (name === 'phone') {
        if (!value) return '';
        const digits = value.replace(/\D/g, '');
        if (digits.length < 7 || digits.length > 15) {
          return 'Enter a valid phone number, or leave this blank.';
        }
        return '';
      }
      if (name === 'company') {
        return '';
      }
      if (name === 'website') {
        if (!value) return '';
        if (!isValidWebsite(value)) return 'Enter a full website URL, like https://yoursite.com.';
        return '';
      }
      if (name === 'reason') {
        if (!value) return 'Choose what you need.';
        return '';
      }
      if (name === 'message') {
        if (!value) return 'Write a short message.';
        if (value.length < 20) return 'Give a bit more detail (at least 20 characters).';
        return '';
      }
      return '';
    }

    function filesErrorMessage() {
      const files = attachedFiles();
      for (const file of files) {
        const typeOk =
          ALLOWED_FILE.test(file.type) || /\.(pdf|png|jpe?g|gif|webp|heic|svg)$/i.test(file.name);
        if (!typeOk) {
          return `"${file.name}" must be an image or PDF.`;
        }
      }
      if (totalBytes() > MAX_TOTAL_BYTES) {
        return `Attachments are ${formatMb(totalBytes())} MB combined. Keep them under 2 MB total.`;
      }
      return '';
    }

    function validateField(field, { show } = { show: false }) {
      const message = fieldErrorMessage(field);
      if (show || touched.has(field.name)) setFieldError(field, message);
      return !message;
    }

    function validateFiles({ show } = { show: false }) {
      const message = filesErrorMessage();
      if (show || touched.has('files')) setFilesError(message);
      return !message;
    }

    function formIsValid() {
      const fields = form.querySelectorAll('input:not([type="file"]), textarea, select');
      let ok = true;
      for (const field of fields) {
        if (!validateField(/** @type {HTMLElement} */ (field), { show: false })) ok = false;
      }
      if (!validateFiles({ show: false })) ok = false;
      return ok;
    }

    function updateSubmitState() {
      if (!(submitBtn instanceof HTMLButtonElement)) return;
      if (sending) {
        submitBtn.disabled = true;
        return;
      }
      const ready = form.dataset.emailjsReady === '1';
      submitBtn.disabled = !(ready && formIsValid());
    }

    function refreshFileList() {
      if (!(fileList instanceof HTMLUListElement)) return;
      const files = attachedFiles();
      fileList.replaceChildren();
      if (!files.length) {
        fileList.hidden = true;
        return;
      }
      fileList.hidden = false;
      for (const file of files) {
        const li = document.createElement('li');
        li.textContent = `${file.name} (${formatMb(file.size)} MB)`;
        fileList.append(li);
      }
      const total = totalBytes();
      const totalLi = document.createElement('li');
      totalLi.className = 'file-total';
      totalLi.textContent = `Total ${formatMb(total)} MB / 2.00 MB`;
      if (total > MAX_TOTAL_BYTES) totalLi.dataset.over = '1';
      fileList.append(totalLi);
    }

    function nextEmptySlot() {
      return slots.findIndex(
        (input) => input instanceof HTMLInputElement && !(input.files && input.files.length),
      );
    }

    picker?.addEventListener('click', () => {
      const idx = nextEmptySlot();
      if (idx === -1) {
        touched.add('files');
        setFilesError('You can attach up to 4 files. Remove one to add another.');
        updateSubmitState();
        return;
      }
      const input = slots[idx];
      if (input instanceof HTMLInputElement) input.click();
    });

    for (const input of slots) {
      input?.addEventListener('change', () => {
        touched.add('files');
        if (!(input instanceof HTMLInputElement) || !input.files?.[0]) {
          refreshFileList();
          validateFiles({ show: true });
          updateSubmitState();
          return;
        }
        const file = input.files[0];
        const typeOk =
          ALLOWED_FILE.test(file.type) || /\.(pdf|png|jpe?g|gif|webp|heic|svg)$/i.test(file.name);
        if (!typeOk) {
          input.value = '';
          setFilesError(`"${file.name}" must be an image or PDF.`);
          refreshFileList();
          updateSubmitState();
          return;
        }
        if (totalBytes() > MAX_TOTAL_BYTES) {
          input.value = '';
          setFilesError(
            `"${file.name}" would push attachments over 2 MB total. Compress or pick a smaller image.`,
          );
          refreshFileList();
          updateSubmitState();
          return;
        }
        setFilesError('');
        setStatus('');
        refreshFileList();
        updateSubmitState();
      });
    }

    form.addEventListener('input', (event) => {
      const target = event.target;
      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement
      ) {
        if (target.type === 'file') return;
        validateField(target, { show: touched.has(target.name) });
        updateSubmitState();
      }
    });

    form.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLSelectElement) {
        touched.add(target.name);
        validateField(target, { show: true });
        updateSubmitState();
      }
    });

    form.addEventListener('blur', (event) => {
      const target = event.target;
      if (
        !(
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          target instanceof HTMLSelectElement
        )
      ) {
        return;
      }
      if (target.type === 'file') return;
      touched.add(target.name);
      if (target.name === 'website' && target.value.trim()) {
        target.value = normalizeWebsite(target.value);
      }
      validateField(target, { show: true });
      updateSubmitState();
    }, true);

    async function loadEmailJs() {
      if (window.emailjs) return window.emailjs;
      await new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error('Could not load EmailJS'));
        document.head.appendChild(script);
      });
      return window.emailjs;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset.emailjsReady !== '1') {
        setStatus('Form is not configured yet. Email hello@localservicerocket.com instead.', 'error');
        return;
      }

      const fields = form.querySelectorAll('input:not([type="file"]), textarea, select');
      let ok = true;
      for (const field of fields) {
        touched.add(/** @type {HTMLInputElement} */ (field).name);
        if (!validateField(/** @type {HTMLElement} */ (field), { show: true })) ok = false;
      }
      touched.add('files');
      if (!validateFiles({ show: true })) ok = false;
      if (!ok) {
        setStatus('Fix the highlighted fields, then try again.', 'error');
        const firstInvalid = form.querySelector('.is-invalid, #err-files:not([hidden])');
        if (firstInvalid instanceof HTMLElement) {
          const focusTarget =
            firstInvalid.classList.contains('is-invalid')
              ? firstInvalid
              : form.querySelector('input[type="file"]');
          if (focusTarget instanceof HTMLElement) focusTarget.focus();
        }
        updateSubmitState();
        return;
      }

      const website = form.elements.namedItem('website');
      if (website instanceof HTMLInputElement && website.value.trim()) {
        website.value = normalizeWebsite(website.value);
      }

      const publicKey = form.dataset.publicKey || '';
      const serviceId = form.dataset.serviceId || '';
      const templateId = form.dataset.templateId || '';

      sending = true;
      updateSubmitState();
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.textContent = 'Sending...';
      }
      setStatus('Sending your message...');

      try {
        const emailjs = await loadEmailJs();
        emailjs.init({ publicKey });
        await emailjs.sendForm(serviceId, templateId, form);
        form.reset();
        touched.clear();
        for (const field of fields) {
          setFieldError(/** @type {HTMLElement} */ (field), '');
        }
        setFilesError('');
        refreshFileList();
        setStatus('Got it. Alistair will reply by email, usually within one business day.', 'ok');
      } catch (err) {
        console.error(err);
        const status = err && typeof err === 'object' && 'status' in err ? Number(err.status) : 0;
        if (status === 413) {
          setStatus(
            'Those files are too large for EmailJS (2 MB total). Compress or remove an attachment and try again.',
            'error',
          );
        } else {
          setStatus(
            'Something went wrong. Email hello@localservicerocket.com instead.',
            'error',
          );
        }
      } finally {
        sending = false;
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.textContent = 'Send it through';
        }
        updateSubmitState();
      }
    });

    updateSubmitState();
  }
</script>

<style>
  .contact {
    padding-bottom: 72px;
  }

  .hero {
    padding-top: 48px;
    padding-bottom: 28px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--muted-3);
    flex-wrap: wrap;
  }

  .crumbs a {
    color: var(--muted-3);
  }

  .current {
    color: var(--ink);
    font-weight: 600;
  }

  .eyebrow {
    margin-top: 22px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--orange);
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
    max-width: 18ch;
  }

  .lede {
    margin-top: 16px;
    font-size: 17.5px;
    line-height: 1.65;
    color: var(--body);
    max-width: 58ch;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 40px 48px;
    align-items: start;
    margin-top: 12px;
  }

  .copy h2 {
    margin-top: 10px;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 18ch;
  }

  .bullets {
    margin: 18px 0 0;
    padding-left: 1.15em;
    color: var(--body);
    font-size: 15.5px;
    line-height: 1.65;
  }

  .bullets li + li {
    margin-top: 10px;
  }

  .aside {
    margin-top: 28px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--section-bg);
  }

  .aside-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    color: var(--muted-3);
  }

  .aside p {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--body);
  }

  .alt-contact {
    margin-top: 16px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  .form-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: #fff;
    padding: 28px 28px 24px;
    box-shadow: 0 12px 40px rgba(26, 26, 26, 0.04);
  }

  .config-warn {
    margin-bottom: 16px;
    padding: 12px 14px;
    border-radius: var(--radius-card);
    background: var(--orange-tint);
    border: 1px solid rgba(232, 89, 12, 0.25);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .row.two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  label,
  .file-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label span,
  .file-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }

  label em,
  .file-label em {
