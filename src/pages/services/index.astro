---
/* Services overview, six service cards linking to detail pages.
   Design source: Services.dc.html. CollectionPage + ItemList schema per SEO guide. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, breadcrumbList, graph } from '../../data/schema';

const cards = [
  {
    href: '/services/local-seo',
    icon: '/assets/icon-local-seo-reviews-v2.svg',
    title: 'Local SEO & Reviews',
    body: 'Get your Google Business Profile showing on the map for your area, and keep new reviews coming in.',
  },
  {
    href: '/services/paid-ads',
    icon: '/assets/icon-paid-ads-lsas-v2.svg',
    title: 'Paid Ads & LSAs',
    body: 'Local Services Ads first, where you pay per lead, then Google Search ads. We prove ads make money before we scale spend.',
  },
  {
    href: '/services/websites',
    icon: '/assets/icon-websites-that-convert-v2.svg',
    title: 'Websites That Get Calls',
    body: 'A fast site that makes a homeowner pick up the phone. You own the whole thing outright.',
  },
  {
    href: '/services/hiring',
    icon: '/assets/icon-hiring-recruiting-v2.svg',
    title: 'Hiring & Recruiting',
    body: 'Job ads and screening that put skilled techs in front of you, usually with enough candidates inside about 10 days.',
  },
  {
    href: '/services/branding',
    icon: '/assets/icon-branding-v2.svg',
    title: 'Branding',
    body: "Logo, van wraps and uniforms your whole city remembers. We built Dry Duck's from scratch.",
  },
  {
    href: '/services/tracking',
    icon: '/assets/icon-tracking-reporting-v2.svg',
    title: 'Tracking & Reporting',
    body: 'You see how many calls and booked jobs came from Google, and whether the money in beats the money out.',
  },
];

const title = 'Marketing Services for Home Service Shops | Local Service Rocket';
const description =
  'Six Google-led services for home service companies: Local SEO, paid ads, websites, hiring, branding, and tracking. Start around $500/month.';
const pageUrl = absoluteUrl('/services/');
const jsonLd = graph([
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': 'https://localservicerocket.com/#website' },
    mainEntity: { '@id': `${pageUrl}#list` },
  },
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#list`,
    name: 'Local Service Rocket services',
    itemListElement: cards.map((card, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: card.title,
      url: absoluteUrl(card.href),
    })),
  },
  breadcrumbList(pageUrl, [
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]),
]);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main>
    <div class="intro container">
      <div class="eyebrow">WHAT WE DO</div>
      <h1>Everything it takes to win on Google. One team.</h1>
      <p>
        Six services that work as one system. We start with the piece that is holding you back,
        usually around $500 a month, and add the rest as the work pays for it.
      </p>
    </div>

    <div class="grid container">
      {
        cards.map((c) => (
          <a href={c.href} class="card">
            <img src={c.icon} alt="" width="38" height="38" loading="lazy" decoding="async" />
            <div class="card-title">{c.title}</div>
            <p>{c.body}</p>
            <div class="learn">Learn more →</div>
          </a>
        ))
      }
    </div>

    <div class="cta container">
      <div class="cta-panel">
        <h2>Not sure where to start?</h2>
        <p>
          That is what the onboarding call is for. We look at your market and tell you the one thing
          to fix first, even when that is the cheapest thing on the list.
        </p>
        <div class="cta-btns">
          <a href="/get-started" class="btn btn-primary">Schedule onboarding</a>
          <a href="/case-studies" class="btn btn-ghost-dark">See client results</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .intro {
    padding-top: 64px;
    text-align: center;
  }

  h1 {
    margin-top: 14px;
    font-size: clamp(32px, 5vw, 47px);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .intro p {
    margin: 16px auto 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
    max-width: 52ch;
  }

  .grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    color: var(--ink);
    display: block;
    transition: border-color 0.2s;
  }

  .card:hover {
    border-color: var(--orange);
    color: var(--ink);
  }

  .card-title {
    font-weight: 800;
    font-size: 17.5px;
    margin-top: 12px;
  }

  .card p {
    margin-top: 6px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.55;
  }

  .learn {
    margin-top: 14px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--orange);
  }

  .cta {
    margin-top: 64px;
    padding-bottom: 72px;
    text-align: center;
  }

  .cta-panel {
    background: var(--dark);
    border-radius: var(--radius-panel);
    padding: 36px;
    color: var(--dark-text);
  }

  .cta-panel h2 {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .cta-panel p {
    margin-top: 10px;
    font-size: 14.5px;
    color: var(--dark-muted);
    line-height: 1.6;
  }

  .cta-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
