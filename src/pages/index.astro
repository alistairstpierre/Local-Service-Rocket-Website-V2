  { href: '/case-studies/hooked-up', name: 'logo-hooked-up', alt: 'Hooked Up Electric', h: 44 },
  { href: '/case-studies', name: 'logo-coastal-current', alt: 'Coastal Current', h: 46 },
  { href: '/case-studies', name: 'logo-pacific', alt: 'Pacific Home Electric', h: 42 },
  { href: '/case-studies', name: 'logo-definite', alt: 'Definite Electric', h: 42 },
  { href: '/case-studies', name: 'logo-austral', alt: 'Austral Energy Solutions', h: 42, radius: true },
  { href: '/case-studies', name: 'logo-motha', alt: 'Motha Electric', h: 44, radius: true },
];

const services = [
  {
    icon: '/assets/icon-local-seo-reviews-v2.svg',
    title: 'Google Profile & Reviews',
    body: 'Get your Google Business Profile showing up on the map when someone nearby searches for an electrician.',
    href: '/services/local-seo',
  },
  {
    icon: '/assets/icon-paid-ads-lsas-v2.svg',
    title: 'Electrician Advertising',
    body: 'Local Services Ads first, where you pay per lead. Google Search ads once those are booking jobs.',
    href: '/services/paid-ads',
  },
  {
    icon: '/assets/icon-websites-that-convert-v2.svg',
    title: 'Websites That Get Calls',
    body: 'A fast site that turns the people who find you into phone calls, not just a good-looking page.',
    href: '/services/websites',
  },
