---
/* Homepage, primary marketing funnel entry.
   Assembles Hero + trust strip, reviews, flight plan, services, case studies,
   trades grid (links to /for/* SEO landings), why-us, and bottom CTA.
   Design source: Local Service Rocket - Homepage.dc.html */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Picture from '../components/Picture.astro';
import { tradeLabelToSlug } from '../data/trades';

const trustLogos = [
  { href: '/case-studies/rewired', name: 'logo-rewired', alt: 'Rewired', h: 48 },
  { href: '/case-studies/honest-hanks', name: 'logo-honest-hanks', alt: "Honest Hank's", h: 50 },
  { href: '/case-studies/dry-duck', name: 'logo-dry-duck', alt: 'Dry Duck', h: 50 },
  { href: '/case-studies/hooked-up', name: 'logo-hooked-up', alt: 'Hooked Up Electric', h: 44 },
  { href: '/case-studies', name: 'logo-motha', alt: 'Motha Electric', h: 44, radius: true },
  { href: '/case-studies', name: 'logo-coastal-current', alt: 'Coastal Current', h: 46 },
  { href: '/case-studies', name: 'logo-pacific', alt: 'Pacific Home Electric', h: 42 },
  { href: '/case-studies', name: 'logo-definite', alt: 'Definite Electric', h: 42 },
  { href: '/case-studies', name: 'logo-austral', alt: 'Austral Energy Solutions', h: 42, radius: true },
  { href: '/case-studies', name: 'logo-c-tinting', alt: 'C Tinting', h: 44 },
];

const services = [
  {
    icon: '/assets/icon-local-seo-reviews-v2.svg',
    title: 'Local SEO & Reviews',
    body: 'Rank in your service area, own the map pack, and build a review engine.',
    href: '/services/local-seo',
  },
  {
    icon: '/assets/icon-paid-ads-lsas-v2.svg',
    title: 'Paid Ads & LSAs',
    body: 'Google Ads and Local Services Ads managed to booked jobs, not clicks.',
    href: '/services/paid-ads',
  },
  {
    icon: '/assets/icon-websites-that-convert-v2.svg',
    title: 'Websites That Convert',
    body: 'Fast, trust-building sites you own outright: design, code, and content.',
    href: '/services/websites',
  },
  {
    icon: '/assets/icon-hiring-recruiting-v2.svg',
    title: 'Hiring & Recruiting',
    body: 'Fill trucks with techs: job marketing, screening systems, onboarding.',
    href: '/services/hiring',
  },
  {
    icon: '/assets/icon-branding-v2.svg',
    title: 'Branding',
    body: 'Logo, trucks, uniforms: a brand homeowners remember and call again.',
    href: '/services/branding',
  },
  {
    icon: '/assets/icon-tracking-reporting-v2.svg',
    title: 'Tracking & Reporting',
    body: 'Every call and job tracked to its source. You see what we see.',
    href: '/services/tracking',
  },
];

const trades = [
  ['trade-electrical.svg', 'Electrical'],
  ['trade-plumbing.svg', 'Plumbing'],
  ['trade-hvac.svg', 'HVAC'],
  ['trade-roofing.svg', 'Roofing'],
  ['trade-waterproofing.svg', 'Waterproofing'],
  ['trade-garage-doors.svg', 'Garage Doors'],
  ['trade-pest-control.svg', 'Pest Control'],
  ['trade-locksmiths.svg', 'Locksmiths'],
  ['trade-appliance-repair.svg', 'Appliance Repair'],
  ['trade-water-damage-restoration.svg', 'Water Damage & Restoration'],
  ['trade-tree-service.svg', 'Tree Service'],
  ['trade-landscaping.svg', 'Landscaping'],
  ['trade-towing.svg', 'Towing'],
  ['trade-junk-removal.svg', 'Junk Removal'],
  ['trade-pressure-washing.svg', 'Pressure Washing'],
  ['trade-septic-sewer.svg', 'Septic & Sewer'],
  ['trade-fencing.svg', 'Fencing'],
  ['trade-painting.svg', 'Painting'],
];
---

<BaseLayout title="Local Service Rocket, Marketing for Home Service Companies">
  <Hero />

  <!-- TRUST STRIP -->
  <section class="trust">
    <div class="trust-logos container">
      {
        trustLogos.map((logo) => (
          <a href={logo.href} class="trust-logo">
            <Picture
              name={logo.name}
              alt={logo.alt}
              height={logo.h}
              style={`height:${logo.h}px;${logo.radius ? 'border-radius:6px;' : ''}`}
            />
          </a>
        ))
      }
    </div>
    <div class="trust-link">
      <a href="#case-studies">See case studies →</a>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section container" id="reviews">
    <div class="section-head">
      <div class="eyebrow">WHAT OUR CLIENTS ARE SAYING</div>
      <h2>The owners we work with say it best.</h2>
    </div>
    <div class="reviews-grid">
      <article class="review-card">
        <div class="review-top">
          <div class="stars">★★★★★</div>
          <a
            href="https://www.youtube.com/watch?v=1DnfD-5fWL8"
            target="_blank"
            rel="noopener"
            class="watch-link"
          >
            <span class="play">▶</span>WATCH THE VIDEO
          </a>
        </div>
        <p>
          "My company went through upwards of a dozen other marketing companies prior to landing
          here, and I can say it's nice to be home where you're treated like family."
        </p>
        <div class="review-author">
          <Picture name="john-headshot" alt="John Senn" width={28} height={28} />
          <div>
            <div class="author-name">John Senn, owner</div>
            <div class="author-meta">Rewired Iowa · electrical · Des Moines, IA</div>
          </div>
        </div>
      </article>

      <article class="review-card">
        <div class="review-top">
          <div class="stars">★★★★★</div>
          <div class="watch-link muted">
            <span class="play">▶</span>WATCH THE VIDEO
          </div>
        </div>
        <p>
          "In 2024 we grew the company by 600%. I'm very happy with our relationship: your response
          time, your availability, your honesty and the highest integrity."
        </p>
        <div class="review-author">
          <Picture name="jason-hooked-up" alt="Jason" width={28} height={28} />
          <div>
            <div class="author-name">Jason, owner</div>
            <div class="author-meta">Hooked Up Electric · electrical · Merkel, TX</div>
          </div>
        </div>
      </article>

      <article class="review-card">
        <div class="review-top">
          <div class="stars">★★★★★</div>
          <a
            href="https://youtube.com/shorts/UtGKH_Aqv1U"
            target="_blank"
            rel="noopener"
            class="watch-link"
          >
            <span class="play">▶</span>WATCH THE VIDEO
          </a>
        </div>
        <p>
          "We just purchased our third van and got it wrapped, and now I'm hiring another electrician
          to keep up with the growth. These guys have been with me every step."
        </p>
        <div class="review-author">
          <Picture name="lewis-carter" alt="Lewis Carter" width={28} height={28} />
          <div>
            <div class="author-name">Lewis Carter, owner</div>
            <div class="author-meta">Honest Hank's · electrician · Tampa, FL</div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- THE SYSTEM -->
  <section class="section container" id="system">
    <div class="flight-plan">
      <div class="flight-copy">
        <div class="eyebrow on-dark">THE FLIGHT PLAN</div>
        <h2>A system we run with owners building something bigger.</h2>
        <p>
          Most tradespeople just want to do good work. If you want to build a company, this is the
          path. Three stages, and you always know where you are and what's next.
        </p>
        <a href="/flight-plan" class="btn btn-primary">See the full flight plan</a>
      </div>
      <div class="flight-steps">
        <div class="flight-step">
          <div class="step-num">1</div>
          <div>
            <div class="step-title">Pre-flight: build it right</div>
            <div class="step-body">
              Fix GBP + website, finish SEO foundations, turn on LSA and local lead providers. Aim
              for about 1-3 booked jobs a day and $40-50k months.
            </div>
          </div>
        </div>
        <div class="flight-step indent-1">
          <div class="step-num">2</div>
          <div>
            <div class="step-title">Liftoff: own your traffic</div>
            <div class="step-body">
              Deepen SEO, brand if you haven’t, then add low-budget Search ads so growth isn’t rented
              from Angi and Yelp forever.
            </div>
          </div>
        </div>
        <div class="flight-step indent-2">
          <div class="step-num">3</div>
          <div>
            <div class="step-title">Orbit: get your time back</div>
            <div class="step-body">
              Scale ad spend with safety rails, hire skilled techs, and build systems so you’re not
              in every truck.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section container" id="services">
    <div class="section-head">
      <div class="eyebrow">WHAT WE DO</div>
      <h2>Everything you need, one team.</h2>
    </div>
    <div class="services-grid">
      {
        services.map((s) => (
          <a href={s.href} class="service-card">
            <img src={s.icon} alt="" width="36" height="36" loading="lazy" decoding="async" />
            <div class="service-title">{s.title}</div>
            <p>{s.body}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section class="section container" id="case-studies">
    <div class="cs-header">
      <div>
        <div class="eyebrow">CASE STUDIES</div>
        <h2>Three ways in.</h2>
        <p class="cs-sub">Scale what you have, grow your crew, or start from nothing.</p>
      </div>
      <a href="/case-studies" class="btn btn-secondary">View all case studies</a>
    </div>

    <div class="cs-grid">
      <a href="/case-studies/rewired" class="cs-card">
        <div class="cs-media">
          <Picture name="team-rewired" alt="Rewired team" sizes="(max-width: 900px) 100vw, 400px" />
          <div class="cs-logo-badge">
            <Picture name="logo-rewired" alt="" height={28} />
          </div>
        </div>
        <div class="cs-body">
          <div class="cs-tag">SCALE WHAT YOU HAVE</div>
          <div class="cs-name">Rewired</div>
          <div class="cs-meta">Electrical · Des Moines, IA</div>
          <div class="cs-stats">
            <div>
              <div class="cs-stat orange">$60k → $220k+</div>
              <div class="cs-stat-label">avg monthly revenue</div>
            </div>
            <div>
              <div class="cs-stat">5 → 12</div>
              <div class="cs-stat-label">crew</div>
            </div>
            <div>
              <div class="cs-stat">1.5 → 6</div>
              <div class="cs-stat-label">avg booked calls / day</div>
            </div>
          </div>
          <div class="cs-link">Read the Rewired story →</div>
        </div>
      </a>

      <a href="/case-studies/honest-hanks" class="cs-card">
        <div class="cs-media">
          <Picture
            name="team-honest-hanks"
            alt="Honest Hank's team"
            sizes="(max-width: 900px) 100vw, 400px"
            style="object-position: center 60%"
          />
          <div class="cs-logo-badge">
            <Picture name="logo-honest-hanks" alt="" height={28} />
          </div>
        </div>
        <div class="cs-body">
          <div class="cs-tag">GROW THE CREW</div>
          <div class="cs-name">Honest Hank's</div>
          <div class="cs-meta">Electrician · Tampa, FL</div>
          <div class="cs-stats">
            <div>
              <div class="cs-stat orange">$25k → $80k</div>
              <div class="cs-stat-label">avg monthly revenue</div>
            </div>
            <div>
              <div class="cs-stat">1 → 3</div>
              <div class="cs-stat-label">techs</div>
            </div>
            <div>
              <div class="cs-stat">8 mo</div>
              <div class="cs-stat-label">working together</div>
            </div>
          </div>
          <div class="cs-link">Read the Honest Hank's story →</div>
        </div>
      </a>

      <a href="/case-studies/dry-duck" class="cs-card">
        <div class="cs-media">
          <Picture name="team-dry-duck" alt="Dry Duck team" sizes="(max-width: 900px) 100vw, 400px" />
          <div class="cs-logo-badge">
            <Picture name="logo-dry-duck" alt="" height={28} />
          </div>
        </div>
        <div class="cs-body">
          <div class="cs-tag">START FROM NOTHING</div>
          <div class="cs-name">Dry Duck</div>
          <div class="cs-meta">Basement waterproofing</div>
          <div class="cs-stats">
            <div>
              <div class="cs-stat orange">$0 → $200k</div>
              <div class="cs-stat-label">monthly revenue in 6 months</div>
            </div>
            <div>
              <div class="cs-stat">5</div>
              <div class="cs-stat-label">full-time staff</div>
            </div>
            <div>
              <div class="cs-stat">6 mo</div>
              <div class="cs-stat-label">from launch</div>
            </div>
          </div>
          <div class="cs-link">Read the Dry Duck story →</div>
        </div>
      </a>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <section class="section container" id="who-we-help">
    <div class="section-head narrow">
      <div class="eyebrow">WHO WE HELP</div>
      <h2>If your customers find you on Google, that's our specialty.</h2>
      <p class="section-sub">
        Any trade that lives on Google search, Maps, and reviews. If that's you and you want to
        grow, we should talk.
      </p>
    </div>
    <div class="trades-grid">
      {
        trades.map(([file, label]) => {
          const slug = tradeLabelToSlug[label];
          const href = slug ? `/for/${slug}` : '/get-started';
          return (
            <a href={href} class="trade-card">
              <img src={`/assets/${file}`} alt="" width="30" height="30" loading="lazy" decoding="async" />
              <div>{label}</div>
            </a>
          );
        })
      }
      <div class="trade-more">
        <div class="trade-more-title">And more.</div>
        <div>
          Not on the list? If you want to dominate on Google in your area, we should still talk.
        </div>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section container" id="about">
    <div class="why-grid">
      <div class="why-video" id="why-video">
        <button
          type="button"
          class="why-video-facade"
          aria-label="Play founder story video"
          data-youtube-id="G1rIxsUm6RQ"
        >
          <Picture
            name="video-founder-story"
            alt="Founder story | Local Service Rocket"
            sizes="(max-width: 900px) 100vw, 560px"
          />
          <span class="why-video-shade" aria-hidden="true"></span>
          <span class="why-video-play" aria-hidden="true">▶</span>
        </button>
      </div>
      <div>
        <div class="eyebrow">WHY LOCAL SERVICE ROCKET</div>
        <h2>We grow when you grow.</h2>
        <div class="why-points">
          <div class="why-point">
            <div class="check">✓</div>
            <div>
              <b>Start at $500/month.</b> No huge commitments before we've proven anything, most
              agencies want $5,000+ up front.
            </div>
          </div>
          <div class="why-point">
            <div class="check">✓</div>
            <div>
              <b>Results before scale.</b> Our first client had burned through seven agencies before
              us. None made him a dollar from ads. We prove results before scaling costs, especially
              ad spend.
            </div>
          </div>
          <div class="why-point">
            <div class="check">✓</div>
            <div>
              <b>A partner, not another agency.</b> You work directly with Alistair St Pierre:
              upfront about what won't work, clear expectations, no account managers.
            </div>
          </div>
        </div>
        <a href="/about" class="about-link">More about Alistair &amp; the agency →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-wrap container">
    <div class="cta-panel">
      <h2>Ready to get off the truck?</h2>
      <p>
        Watch a short video on exactly how it works and what it costs, then book your onboarding
        call. No sales calls. Your first call with us is already about your business.
      </p>
      <div class="cta-btns">
        <a href="/get-started" class="btn btn-primary btn-lg">Schedule onboarding</a>
        <a href="#case-studies" class="btn btn-ghost-dark btn-lg">See client results</a>
      </div>
      <p class="cta-price">Starts at $500/month. We grow when you grow.</p>
      <div class="cta-meta">
        <span>★★★★★ 5.0 on Google</span>
        <span>(888) 371-6365</span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Click-to-play: swap facade for a full-bleed iframe (inline styles, Astro scope
  // would otherwise miss the dynamically inserted iframe and leave it 300×150).
  const player = document.getElementById('why-video');
  const facade = player?.querySelector<HTMLButtonElement>('.why-video-facade');

  facade?.addEventListener('click', () => {
    const id = facade.dataset.youtubeId;
    if (!id || !player) return;

    facade.classList.add('is-loading');
    facade.setAttribute('aria-busy', 'true');

    const iframe = document.createElement('iframe');
    iframe.className = 'why-video-embed';
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1&iv_load_policy=3`;
    iframe.title = 'Founder story | Local Service Rocket';
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
    // Full-bleed, do not rely on scoped CSS for JS-injected nodes
    Object.assign(iframe.style, {
      position: 'absolute',
      inset: '0',
      width: '100%',
      height: '100%',
      border: '0',
      display: 'block',
      background: '#111',
    });

    iframe.addEventListener(
      'load',
      () => {
        facade.remove();
      },
      { once: true }
    );

    player.appendChild(iframe);
  });
</script>

<style>
  .section {
    padding-top: 72px;
  }

  .section-head {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  .section-head.narrow {
    max-width: 520px;
  }

  .section-head h2,
  .why-grid h2 {
    margin-top: 10px;
    font-size: clamp(28px, 3vw, 34px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .section-sub,
  .cs-sub {
    margin-top: 10px;
    font-size: 15px;
    color: var(--muted);
  }

  /* Trust */
  .trust {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--section-bg);
  }

  .trust-logos {
    padding-top: 26px;
    padding-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 44px;
    flex-wrap: wrap;
  }

  /* :global() because <Picture> renders the <img> from a child component. */
  .trust-logo :global(img) {
    width: auto;
    filter: grayscale(1);
    opacity: 0.62;
    transition:
      filter 0.2s,
      opacity 0.2s;
  }

  .trust-logo:hover :global(img) {
    filter: grayscale(0);
    opacity: 1;
  }

  .trust-link {
    text-align: center;
    padding: 0 var(--pad-x) 20px;
    font-size: 13.5px;
    font-weight: 700;
  }

  /* Reviews */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .review-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 20px;
  }

  .review-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stars {
    color: var(--orange);
    font-size: 14px;
    letter-spacing: 2px;
  }

  .watch-link {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    color: var(--orange);
    font-weight: 700;
  }

  .watch-link.muted {
    cursor: default;
  }

  .play {
    width: 16px;
    height: 16px;
    border-radius: 99px;
    background: var(--orange);
    color: #fff;
    font-size: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .review-card p {
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--body);
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 14px;
  }

  .review-author :global(img) {
    width: 28px;
    height: 28px;
    border-radius: 99px;
    object-fit: cover;
  }

  .author-name {
    font-size: 13px;
    font-weight: 700;
  }

  .author-meta {
    font-size: 11.5px;
    color: var(--muted-3);
  }

  /* Flight plan */
  .flight-plan {
    background: var(--dark);
    border-radius: var(--radius-large);
    padding: 48px;
    color: var(--dark-text);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
  }

  .eyebrow.on-dark {
    color: var(--orange-on-dark);
  }

  .flight-copy h2 {
    margin-top: 12px;
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .flight-copy p {
    margin: 14px 0 22px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--dark-muted);
    text-wrap: pretty;
  }

  .flight-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .flight-step {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-card);
    padding: 16px 18px;
    display: flex;
    gap: 14px;
  }

  .flight-step.indent-1 {
    margin-left: 20px;
  }

  .flight-step.indent-2 {
    margin-left: 40px;
  }

  .step-num {
    width: 34px;
    height: 34px;
    border-radius: 99px;
    background: var(--orange);
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .step-title {
    font-weight: 700;
    font-size: 15.5px;
  }

  .step-body {
    font-size: 13px;
    color: var(--dark-muted);
    margin-top: 2px;
    line-height: 1.5;
  }

  /* Services */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .service-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 22px;
