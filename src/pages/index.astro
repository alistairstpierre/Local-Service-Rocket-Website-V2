const homeTitle = 'Marketing for Electricians Wired to Scale | Local Service Rocket';
const homeDescription =
  'Marketing for electricians from $500/mo. Fee climbs with your shop. No $5k setup. Book onboarding online.';

const faqs = [
  {
    q: 'What do you actually do for my shop?',
    a: 'First we build the structure: your website, your Google Business Profile, and Local Services Ads, plus the other lead profiles that matter. Once those are booking jobs, we add Google Search ads and more SEO. About $500 a month to start.',
  },
  {
    q: 'Do you spend big on ads straight away?',
    a: 'No. We get the free stuff working first, your Google profile and your website, then Local Services Ads where you pay per lead. Search ads come after that is booking jobs. That is how Rewired, Honest Hank\'s, and Hooked Up grew.',
  },
  {
    q: 'Do you only work with electrical companies?',
    a: 'Electrical is where we have the most proof: Rewired, Honest Hank\'s, Hooked Up, and Motha. We work with other home service trades too.',
  },
