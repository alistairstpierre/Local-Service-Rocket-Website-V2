    a: '$500 a month. The fee only goes up once your shop is bigger, not before. Most agencies quote it the other way around: a big setup fee and three months up front, before they have proved anything.',
  },
];

const pageUrl = absoluteUrl('/');
const jsonLd = graph([
  webPageNode({
    pageUrl,
    name: homeTitle,
    description: homeDescription,
  }),
  faqPageNode(pageUrl, faqs),
]);
---

